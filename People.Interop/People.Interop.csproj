<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\People.Core\People.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="runtimes\win-x64\native\whatsapp_bridge.dll">
      <Link>whatsapp_bridge.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="SyncNativeWhatsAppBridge" BeforeTargets="BeforeBuild;AssignTargetPaths">
    <PropertyGroup>
      <NativeBridgeSource Condition="Exists('$(MSBuildThisFileDirectory)..\..\native\whatsapp-bridge\target\release\whatsapp_bridge.dll')">$(MSBuildThisFileDirectory)..\..\native\whatsapp-bridge\target\release\whatsapp_bridge.dll</NativeBridgeSource>
    </PropertyGroup>
    <Copy SourceFiles="$(NativeBridgeSource)"
          DestinationFiles="$(MSBuildThisFileDirectory)runtimes\win-x64\native\whatsapp_bridge.dll"
          Condition="'$(NativeBridgeSource)' != '' and Exists('$(NativeBridgeSource)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
