<UserControl
    x:Class="People.Controls.ReactionPillControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Bouncy Pop-In Storyboard using BackEase overshoot -->
        <Storyboard x:Name="PopInStoryboard">
            <DoubleAnimation Storyboard.TargetName="PillScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.3" To="1.0"
                             Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.45" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PillScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.3" To="1.0"
                             Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.45" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PillBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0"
                             Duration="0:0:0.16">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Bouncy Pop-Out Storyboard -->
        <Storyboard x:Name="PopOutStoryboard">
            <DoubleAnimation Storyboard.TargetName="PillScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1.0" To="0.2"
                             Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseIn" Amplitude="0.4" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PillScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="1.0" To="0.2"
                             Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseIn" Amplitude="0.4" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PillBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.0"
                             Duration="0:0:0.16">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Playful Pulse Bounce Storyboard for Reaction Updates -->
        <Storyboard x:Name="BouncePulseStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PillScale"
                                           Storyboard.TargetProperty="ScaleX">
                <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.09" Value="1.18" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="0.96" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.25" Value="1.00" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PillScale"
                                           Storyboard.TargetProperty="ScaleY">
                <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.09" Value="1.18" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="0.96" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.25" Value="1.00" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <Button x:Name="PillButton"
            Click="PillButton_Click"
            Padding="6,2,7,2"
            CornerRadius="11"
            BorderThickness="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            MinHeight="22"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">
        <Border x:Name="PillBorder"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="PillScale" CenterX="0" CenterY="0" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                <ItemsControl x:Name="EmojisItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" FontSize="12" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="TotalCountTextBlock"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="2,0,0,0" />
            </StackPanel>
        </Border>
    </Button>
</UserControl>
