<UserControl
    x:Class="People.Controls.WhiteBoardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Top Pen Controls & History (Outside Drawing Board) -->
        <Border Grid.Row="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="6,4">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="2">
                <InkToolbar x:Name="MyInkToolbar"
                            TargetInkCanvas="{x:Bind MyInkCanvas}"
                            InitialControls="None"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <InkToolbarBallpointPenButton x:Name="BallpointPenBtn" />
                    <InkToolbarPencilButton />
                    <InkToolbarHighlighterButton />
                    <InkToolbarEraserButton IsClearAllVisible="True" />
                </InkToolbar>

                <CommandBar DefaultLabelPosition="Collapsed"
                            OverflowButtonVisibility="Collapsed"
                            Background="Transparent"
                            VerticalAlignment="Center">
                    <CommandBar.PrimaryCommands>
                        <AppBarSeparator />
                        <AppBarButton x:Name="UndoButton"
                                      Icon="Undo"
                                      Label="Undo"
                                      Click="Undo_Click"
                                      IsEnabled="False"
                                      ToolTipService.ToolTip="Undo (Ctrl+Z)"
                                      AutomationProperties.Name="Undo">
                            <AppBarButton.KeyboardAccelerators>
                                <KeyboardAccelerator x:Name="UndoAccelerator" Key="Z" Modifiers="Control" />
                            </AppBarButton.KeyboardAccelerators>
                        </AppBarButton>
                        <AppBarButton x:Name="RedoButton"
                                      Icon="Redo"
                                      Label="Redo"
                                      Click="Redo_Click"
                                      IsEnabled="False"
                                      ToolTipService.ToolTip="Redo (Ctrl+Y)"
                                      AutomationProperties.Name="Redo">
                            <AppBarButton.KeyboardAccelerators>
                                <KeyboardAccelerator x:Name="RedoAccelerator" Key="Y" Modifiers="Control" />
                            </AppBarButton.KeyboardAccelerators>
                        </AppBarButton>
                    </CommandBar.PrimaryCommands>
                </CommandBar>
            </StackPanel>
        </Border>

        <!-- 2. Pure Drawing Board Canvas Surface (Row 1, opaque white) -->
        <Border Grid.Row="1"
                Background="#FFFFFF"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <InkCanvas x:Name="MyInkCanvas"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch" />
        </Border>

        <!-- 3. Bottom Caption Input & Action Buttons (Row 2) -->
        <Grid Grid.Row="2"
              ColumnSpacing="8"
              VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="CaptionTextBox"
                     Grid.Column="0"
                     PlaceholderText="Add a caption..."
                     VerticalAlignment="Center"
                     HorizontalAlignment="Stretch"
                     MaxLength="1024"
                     CornerRadius="4"
                     GotFocus="CaptionTextBox_GotFocus"
                     LostFocus="CaptionTextBox_LostFocus"
                     KeyDown="CaptionTextBox_KeyDown"
                     AutomationProperties.Name="Image caption" />

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                <Button Content="Cancel"
                        Click="Cancel_Click"
                        CornerRadius="4"
                        Height="34"
                        Padding="14,4" />
                <Button x:Name="SendButton"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="Send_Click"
                        CornerRadius="4"
                        Height="34"
                        Padding="14,4"
                        AutomationProperties.Name="Send drawing">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE724;" FontSize="13" />
                        <TextBlock Text="Send" FontWeight="SemiBold" FontSize="13" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
