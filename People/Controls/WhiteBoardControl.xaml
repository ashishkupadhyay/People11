<UserControl
    x:Class="People.Controls.WhiteBoardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Frosted Glass Acrylic for Whiteboard Drawing Surface -->
        <AcrylicBrush x:Key="WhiteBoardCanvasAcrylicBrush"
                      TintColor="#FFFFFF"
                      TintOpacity="0.88"
                      FallbackColor="#FFFFFFFF" />
    </UserControl.Resources>

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Top Pen Controls (Outside Drawing Board) -->
        <Border Grid.Row="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="6,4">
            <InkToolbar x:Name="MyInkToolbar"
                        TargetInkCanvas="{x:Bind MyInkCanvas}"
                        InitialControls="None"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <InkToolbarBallpointPenButton x:Name="BallpointPenBtn" />
                <InkToolbarPencilButton />
                <InkToolbarHighlighterButton />
                <InkToolbarEraserButton IsClearAllVisible="True" />
            </InkToolbar>
        </Border>

        <!-- 2. Pure Drawing Board Canvas Surface (Row 1) -->
        <Border Grid.Row="1"
                Background="{StaticResource WhiteBoardCanvasAcrylicBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <InkCanvas x:Name="MyInkCanvas"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch" />
        </Border>

        <!-- 3. Bottom Action Buttons (Outside Drawing Board, Bottom Right) -->
        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
            <Button Content="Cancel"
                    Click="Cancel_Click"
                    CornerRadius="4"
                    Height="34"
                    Padding="14,4" />
            <Button x:Name="SendButton"
                    Style="{ThemeResource AppAccentButtonStyle}"
                    Click="Send_Click"
                    CornerRadius="4"
                    Height="34"
                    Padding="14,4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE724;" FontSize="13" />
                    <TextBlock Text="Send" FontWeight="SemiBold" FontSize="13" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
