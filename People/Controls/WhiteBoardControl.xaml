<UserControl
    x:Class="People.Controls.WhiteBoardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header & Native InkToolbar -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,6">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="4,0,8,0">
                    <FontIcon Glyph="&#xEE56;" FontSize="18" Foreground="{ThemeResource AppAccentBrush}" />
                    <TextBlock Text="White Board" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center: Native WinUI 3 InkToolbar -->
                <InkToolbar x:Name="MyInkToolbar"
                            Grid.Column="1"
                            TargetInkCanvas="{x:Bind MyInkCanvas}"
                            InitialControls="None"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <InkToolbarBallpointPenButton x:Name="BallpointPenBtn" />
                    <InkToolbarPencilButton />
                    <InkToolbarHighlighterButton />
                    <InkToolbarEraserButton IsClearAllVisible="True" />
                </InkToolbar>

                <!-- Right: Cancel & Send Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Cancel" Click="Cancel_Click" CornerRadius="4" Height="34" Padding="12,4" />
                    <Button x:Name="SendButton"
                            Style="{ThemeResource AppAccentButtonStyle}"
                            Click="Send_Click"
                            CornerRadius="4"
                            Height="34"
                            Padding="14,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE724;" FontSize="14" />
                            <TextBlock Text="Send Image" FontWeight="SemiBold" FontSize="13" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Native InkCanvas Surface -->
        <Border Grid.Row="1"
                Background="#FFFFFFFF"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <InkCanvas x:Name="MyInkCanvas"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch" />
        </Border>

        <!-- Bottom Footer Helper Text -->
        <Grid Grid.Row="2">
            <TextBlock Text="Draw using your pen, stylus, touch, or mouse. Tap 'Send Image' to share directly in chat."
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
