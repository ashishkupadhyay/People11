<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="People.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:People"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:converters="using:People.Converters"
    mc:Ignorable="d"
    Title="People">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Grid.Row="0" Grid.ColumnSpan="2" Canvas.ZIndex="10" Background="Transparent"
                  AutomationProperties.AutomationId="AppTitleBar"
                  Title="People"
                  IsBackButtonVisible="{x:Bind ViewModel.IsBackEnabled, Mode=OneWay}"
                  BackRequested="AppTitleBar_BackRequested"
                  IsPaneToggleButtonVisible="True"
                  PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.LeftHeader>
                <FontIcon Glyph="&#xE716;" FontSize="16" IsHitTestVisible="False" Margin="12,0,12,0" VerticalAlignment="Center" />
            </TitleBar.LeftHeader>
        </TitleBar>

        <NavigationView x:Name="NavView" Grid.Row="1" Grid.RowSpan="1"
                        AutomationProperties.AutomationId="NavView"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        ItemInvoked="NavView_ItemInvoked"
                        DisplayModeChanged="NavView_DisplayModeChanged"
                        PaneDisplayMode="LeftCompact"
                        AlwaysShowHeader="False">
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="WhatsApp" x:Uid="NavWhatsApp" AutomationProperties.AutomationId="NavWhatsApp">
                    <NavigationViewItem.Icon>
                        <PathIcon x:Name="NavWhatsAppIcon"
                                  Data="F1 M 9,0 C 4.03,0 0,4.03 0,9 C 0,10.635 0.436,12.169 1.198,13.49 L 0,18 L 4.676,16.895 C 5.959,17.599 7.433,18 9,18 C 13.971,18 18,13.971 18,9 C 18,4.03 13.971,0 9,0 Z M 9,16.388 C 7.496,16.388 6.097,15.938 4.929,15.166 L 2.167,15.87 L 2.942,13.229 C 2.104,12.031 1.612,10.573 1.612,9 C 1.612,4.92 4.92,1.612 9,1.612 C 13.08,1.612 16.388,4.92 16.388,9 C 16.388,13.08 13.08,16.388 9,16.388 Z M 11.109,10.188 L 13.286,11.214 C 13.386,11.261 13.45,11.363 13.441,11.473 C 13.418,11.759 13.303,12.334 12.788,12.849 C 11.335,14.301 8.726,12.658 8.619,12.594 C 7.978,12.249 7.368,11.788 6.79,11.21 C 6.212,10.632 5.75,10.022 5.405,9.38 C 5.342,9.274 3.698,6.665 5.151,5.212 C 5.666,4.697 6.24,4.582 6.527,4.559 C 6.637,4.55 6.738,4.614 6.785,4.713 L 7.812,6.891 C 7.86,6.994 7.839,7.117 7.758,7.197 L 6.993,7.962 C 6.828,8.128 6.779,8.386 6.893,8.59 C 7.172,9.091 7.548,9.573 7.983,10.017 C 8.427,10.452 8.909,10.828 9.41,11.107 C 9.614,11.22 9.872,11.172 10.037,11.006 L 10.803,10.241 C 10.883,10.161 11.006,10.139 11.109,10.188 Z" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="SMS" x:Uid="NavSMS" AutomationProperties.AutomationId="NavSMS">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8BD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Telegram" x:Uid="NavTelegram" AutomationProperties.AutomationId="NavTelegram">
                    <NavigationViewItem.Icon>
                        <ImageIcon x:Name="NavTelegramIcon" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Signal" x:Uid="NavSignal" AutomationProperties.AutomationId="NavSignal">
                    <NavigationViewItem.Icon>
                        <ImageIcon x:Name="NavSignalIcon" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Discord" x:Uid="NavDiscord" AutomationProperties.AutomationId="NavDiscord">
                    <NavigationViewItem.Icon>
                        <ImageIcon x:Name="NavDiscordIcon" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            
            <Frame x:Name="ContentFrame" Margin="0,0,0,0" Padding="0,0,0,0">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition />
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>

        <!-- Native Fluent Launch Splash Screen Overlay -->
        <Grid x:Name="SplashOverlay" Grid.Row="0" Grid.RowSpan="2" Canvas.ZIndex="1000"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
                <Image Source="ms-appx:///Assets/SplashScreen.scale-200.png"
                       Width="220" Height="110" Stretch="Uniform"
                       HorizontalAlignment="Center" />
                <ProgressRing IsActive="True" Width="28" Height="28" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
