<Page
    x:Class="People.Views.ChatListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:People.Converters"
    xmlns:models="using:People.Core.Models"
    xmlns:lottie="using:CommunityToolkit.WinUI.Lottie"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:ByteArrayToImageSourceConverter x:Key="ByteArrayToImageSourceConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter" />
        <converters:PersonPictureDisplayNameConverter x:Key="PersonPictureDisplayNameConverter" />
        <converters:ChatTimestampConverter x:Key="ChatTimestampConverter" />
        <converters:ChatLastMessagePreviewConverter x:Key="ChatLastMessagePreviewConverter" />
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter" />
        <converters:UnreadToTimestampBrushConverter x:Key="UnreadToTimestampBrushConverter" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" />
    </Page.Resources>

    <Grid x:Name="RootGrid">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ListColumn.Width" Value="320" />
                        <Setter Target="DetailColumn.Width" Value="*" />
                        <Setter Target="ListGrid.(Grid.Column)" Value="0" />
                        <Setter Target="ListGrid.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="DetailFrame.(Grid.Column)" Value="1" />
                        <Setter Target="DetailFrame.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="DetailFrame.CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                        <Setter Target="ListGrid.Visibility" Value="Visible" />
                        <Setter Target="DetailFrame.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ListColumn.Width" Value="*" />
                        <Setter Target="DetailColumn.Width" Value="*" />
                        <Setter Target="ListGrid.(Grid.Column)" Value="0" />
                        <Setter Target="ListGrid.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="DetailFrame.(Grid.Column)" Value="0" />
                        <Setter Target="DetailFrame.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="DetailFrame.CornerRadius" Value="0" />
                        <!-- Visibility handled by code-behind based on selection -->
                        <Setter Target="PlaceholderGrid.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="MainContentGrid">
            <Grid.RenderTransform>
                <CompositeTransform x:Name="MainLayoutTransform" />
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="320" />
                <ColumnDefinition x:Name="DetailColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="ListGrid" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Padding="16" Spacing="12">
                <TextBlock x:Uid="ChatsTitle" Style="{ThemeResource TitleTextBlockStyle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox Grid.Column="0" x:Name="SearchChatsBox" x:Uid="SearchChatsBox" QueryIcon="Find" TextChanged="SearchChatsBox_TextChanged" AutomationProperties.Name="Search chats" AutomationProperties.AutomationId="SearchChatsBox">
                        <AutoSuggestBox.Resources>
                            <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="AppAccentElevationBorderFocusedBrush" />
                        </AutoSuggestBox.Resources>
                    </AutoSuggestBox>
                    
                    <!-- New Chat Button -->
                    <Button Grid.Column="1" Margin="12,0,0,0" Padding="8,6" Style="{ThemeResource AppAccentButtonStyle}" x:Uid="NewChatBtn" AutomationProperties.AutomationId="NewChatBtn">
                        <Button.Flyout>
                            <Flyout x:Name="NewChatFlyout">
                                <StackPanel Width="320" Spacing="12">
                                    <TextBlock x:Uid="NewChatText" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <AutoSuggestBox x:Name="SearchContactsBox" x:Uid="SearchContactsBox" QueryIcon="Find"
                                                    PlaceholderText="Search name or type phone number..."
                                                    TextChanged="SearchContactsBox_TextChanged"
                                                    AutomationProperties.AutomationId="SearchContactsBox">
                                        <AutoSuggestBox.Resources>
                                            <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="AppAccentElevationBorderFocusedBrush" />
                                        </AutoSuggestBox.Resources>
                                    </AutoSuggestBox>
                                    <!-- Contacts list -->
                                    <ListView x:Name="NewChatList"
                                              ItemsSource="{x:Bind ViewModel.FilteredContacts, Mode=OneWay}"
                                              SelectionMode="Single"
                                              IsItemClickEnabled="True"
                                              ItemClick="NewChatList_ItemClick"
                                              MaxHeight="450"
                                              AutomationProperties.Name="New chat list"
                                              AutomationProperties.AutomationId="NewChatList">
                                        <ListView.ItemContainerTransitions>
                                            <TransitionCollection>
                                                <EntranceThemeTransition IsStaggeringEnabled="True" />
                                            </TransitionCollection>
                                        </ListView.ItemContainerTransitions>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:Contact">
                                                <Grid Padding="4,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <PersonPicture Grid.Column="0" 
                                                                   ProfilePicture="{x:Bind ProfilePictureUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                                   Initials="{x:Bind Initials, Mode=OneWay}"
                                                                   DisplayName="{x:Bind Name, Mode=OneWay, Converter={StaticResource PersonPictureDisplayNameConverter}}" 
                                                                   Width="36" Height="36" Margin="0,0,10,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Name, Mode=OneTime}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{x:Bind PhoneNumber, Mode=OneTime}" 
                                                                   Style="{ThemeResource CaptionTextBlockStyle}" 
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Visibility="{x:Bind PhoneNumber, Mode=OneTime, Converter={StaticResource StringToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                    </Button>
                </Grid>

                <!-- Launch Sync Progress Bar -->
                <ProgressBar Height="2"
                             Margin="0,-4,0,0"
                             IsIndeterminate="{x:Bind ViewModel.IsSyncIndeterminate, Mode=OneWay}"
                             Value="{x:Bind ViewModel.SyncProgress, Mode=OneWay}"
                             Maximum="100"
                             Foreground="{ThemeResource AppAccentBrush}"
                             Visibility="{x:Bind ViewModel.IsSyncing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                             AutomationProperties.Name="Syncing messages" />
            </StackPanel>

            <InfoBar Grid.Row="1"
                     IsOpen="{x:Bind ViewModel.HasNonBlockingError, Mode=OneWay}"
                     Severity="Warning"
                     Title="WhatsApp Connection"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     IsClosable="False"
                     Canvas.ZIndex="10"
                     VerticalAlignment="Top">
                <InfoBar.ActionButton>
                    <Button Content="Retry" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.RetryConnectCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <ListView x:Name="ChatsListView" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Chats, Mode=OneWay}" 
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="ChatList_ItemClick"
                      AutomationProperties.Name="Chats list"
                      AutomationProperties.AutomationId="ChatsListView">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" />
                        <AddDeleteThemeTransition />
                        <ReorderThemeTransition />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Chat">
                        <Grid Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <PersonPicture Grid.Column="0" 
                                           ProfilePicture="{x:Bind PictureUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                           IsGroup="{x:Bind IsGroup, Mode=OneWay}"
                                           Initials="{x:Bind Initials, Mode=OneWay}"
                                           DisplayName="{x:Bind Title, Mode=OneWay, Converter={StaticResource PersonPictureDisplayNameConverter}}" 
                                           Width="48" Height="48" Margin="0,0,12,0"/>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind LastMessagePreview, Mode=OneWay}" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                           TextTrimming="CharacterEllipsis" 
                                           MaxLines="1" />
                            </StackPanel>

                            <!-- Right-aligned timestamp and unread badge -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="4" Margin="8,0,0,0">
                                <TextBlock Text="{x:Bind LastMessageTime, Mode=OneWay, Converter={StaticResource ChatTimestampConverter}}" 
                                           Style="{ThemeResource CaptionTextBlockStyle}" 
                                           Foreground="{x:Bind UnreadCount, Mode=OneWay, Converter={StaticResource UnreadToTimestampBrushConverter}}" 
                                           HorizontalAlignment="Right" />
                                
                                <Border Background="{ThemeResource AppAccentBrush}" 
                                        CornerRadius="10" 
                                        Padding="6,1" 
                                        MinHeight="18" 
                                        MinWidth="18" 
                                        HorizontalAlignment="Right"
                                        Visibility="{x:Bind UnreadCount, Mode=OneWay, Converter={StaticResource IntToVisibilityConverter}}">
                                    <TextBlock Text="{x:Bind UnreadCount, Mode=OneWay}" 
                                               FontSize="11" 
                                               FontWeight="SemiBold" 
                                               Foreground="{ThemeResource AppAccentForegroundBrush}" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Placeholder behind DetailFrame -->
        <Grid x:Name="PlaceholderGrid" Grid.Column="1" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" 
              CornerRadius="{ThemeResource OverlayCornerRadius}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,1,0,0"
              Padding="24">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
                <AnimatedVisualPlayer x:Name="EmptyStatePlayer" AutoPlay="False" Width="120" Height="120">
                    <lottie:LottieVisualSource x:Name="EmptyStateLottieSource" />
                </AnimatedVisualPlayer>
                <TextBlock x:Uid="NoChatSelectedText" 
                           Style="{ThemeResource TitleTextBlockStyle}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" 
                           TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Pane 3: Detail View -->
        <Frame x:Name="DetailFrame" Grid.Column="1" Background="Transparent" CornerRadius="{ThemeResource OverlayCornerRadius}"
               IsHitTestVisible="False" Visibility="Collapsed"
               BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,1,0,0">
            <Frame.ContentTransitions>
                <TransitionCollection>
                    <NavigationThemeTransition>
                        <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                            <SlideNavigationTransitionInfo Effect="FromRight"/>
                        </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                    </NavigationThemeTransition>
                </TransitionCollection>
            </Frame.ContentTransitions>
        </Frame>
        </Grid>

        <!-- Onboarding Doodle Host: Welcome Screen & QR Link Screen on full-page tiled WhatsApp doodle -->
        <Grid x:Name="OnboardingDoodleHost" Canvas.ZIndex="50"
              Visibility="{x:Bind ViewModel.IsOnboardingActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <!-- Full-page tiled doodle background -->
            <Canvas x:Name="OnboardingDoodleCanvas" Opacity="0.08" IsHitTestVisible="False"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    SizeChanged="OnboardingDoodleCanvas_SizeChanged" />

            <!-- 1. Welcome Screen Overlay -->
            <Grid x:Name="WelcomeOverlay" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  Visibility="{x:Bind ViewModel.IsWelcomeVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RenderTransform>
                    <CompositeTransform x:Name="WelcomeTransform" />
                </Grid.RenderTransform>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24" MaxWidth="500">
                    <!-- Theme-aware grey WhatsApp logo -->
                    <Viewbox Width="80" Height="80" HorizontalAlignment="Center">
                        <Canvas Width="720" Height="720">
                            <Path Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                  Data="M360,0C161.18,0,0,161.18,0,360c0,65.41,17.45,126.75,47.94,179.61L0,720l187.02-44.21c51.34,28.18,110.28,44.21,172.98,44.21,198.82,0,360-161.18,360-360S558.82,0,360,0ZM360,655.52c-60.17,0-116.13-17.98-162.82-48.87l-110.49,28.14,30.99-105.61c-33.53-47.93-53.2-106.26-53.2-169.19,0-163.21,132.31-295.52,295.52-295.52s295.52,132.31,295.52,295.52-132.31,295.52-295.52,295.52Z M444.35,407.52l87.1,41.06c4,1.88,6.56,5.94,6.2,10.34-.94,11.46-5.54,34.43-26.13,55.02-58.12,58.12-162.49-7.64-166.74-10.18-25.67-13.79-50.06-32.24-73.19-55.36-23.12-23.12-41.58-47.52-55.37-73.19-2.55-4.24-68.31-108.61-10.18-166.74,20.59-20.59,43.56-25.19,55.02-26.13,4.41-.36,8.46,2.2,10.34,6.2l41.07,87.1c1.94,4.12,1.09,9.02-2.13,12.24l-30.61,30.61c-6.62,6.62-8.56,16.93-4,25.11,11.17,20.03,26.19,39.32,43.59,57.07,17.75,17.4,37.04,32.43,57.07,43.59,8.18,4.56,18.48,2.62,25.11-4l30.61-30.61c3.22-3.22,8.12-4.08,12.24-2.13Z" />
                        </Canvas>
                    </Viewbox>

                    <!-- Grey text: "Welcome to WhatsApp for People" -->
                    <TextBlock Text="Welcome to WhatsApp for People"
                               Style="{ThemeResource TitleTextBlockStyle}"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />

                    <!-- "Get started" button following WhatsApp selected accent settings -->
                    <Button Content="Get started"
                            Style="{ThemeResource AppAccentButtonStyle}"
                            Command="{x:Bind ViewModel.StartLinkingCommand}"
                            MinWidth="130"
                            Padding="16,6"
                            HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- 2. QR Link Screen Overlay -->
            <Grid x:Name="QrLinkOverlay" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  Visibility="{x:Bind ViewModel.IsQrLinkVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RenderTransform>
                    <CompositeTransform x:Name="QrLinkTransform" />
                </Grid.RenderTransform>
                <!-- Large rectangular card virtually divided into two sections (Opaque background) -->
                <Border Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        BackgroundSizing="InnerBorderEdge"
                        Padding="36,32,36,32"
                        MaxWidth="780"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid ColumnSpacing="36">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left section: Instructions with interconnected circles 1, 2, 3 -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="To set up WhatsApp on your computer"
                                       Style="{ThemeResource SubtitleTextBlockStyle}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,24" />

                            <!-- Instructions with interconnected circles -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Step 1: Connector from center of Circle 1 to bottom of row, and Circle 1 -->
                                <Rectangle Grid.Row="0" Grid.Column="0" Width="1.5"
                                           Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Stretch"
                                           Margin="0,14,0,0" />
                                <Border Grid.Row="0" Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                                        BorderThickness="1.5" BorderBrush="{ThemeResource TextFillColorSecondaryBrush}"
                                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Top">
                                    <TextBlock Text="1" FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="14,4,0,28" VerticalAlignment="Top"
                                           Text="Open WhatsApp on your phone"
                                           Style="{ThemeResource BodyTextBlockStyle}" />

                                <!-- Step 2: Connector spanning entire row, and Circle 2 covering top -->
                                <Rectangle Grid.Row="1" Grid.Column="0" Width="1.5"
                                           Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Stretch" />
                                <Border Grid.Row="1" Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                                        BorderThickness="1.5" BorderBrush="{ThemeResource TextFillColorSecondaryBrush}"
                                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Top">
                                    <TextBlock Text="2" FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="14,4,0,28" VerticalAlignment="Top"
                                           Text="Tap Menu on Android, or Settings on iPhone"
                                           Style="{ThemeResource BodyTextBlockStyle}" />

                                <!-- Step 3: Connector entering top of Circle 3, and Circle 3 (no line below) -->
                                <Rectangle Grid.Row="2" Grid.Column="0" Width="1.5"
                                           Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Top"
                                           Height="14" />
                                <Border Grid.Row="2" Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                                        BorderThickness="1.5" BorderBrush="{ThemeResource TextFillColorSecondaryBrush}"
                                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Top">
                                    <TextBlock Text="3" FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="14,4,0,0" Spacing="4" VerticalAlignment="Top">
                                    <TextBlock Text="Tap Linked devices and then Link a device"
                                               Style="{ThemeResource BodyTextBlockStyle}" />
                                    <TextBlock Text="Point your phone at this screen to capture the QR code."
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <Button Grid.Row="2" Content="Switch to Demo / Testing Mode"
                                    Style="{ThemeResource DefaultButtonStyle}"
                                    HorizontalAlignment="Left" Margin="0,20,0,0"
                                    Command="{x:Bind ViewModel.UseTestingModeCommand}" />
                        </Grid>

                        <!-- Right section: Live QR code -->
                        <Border Grid.Column="1" Background="White" Padding="14"
                                CornerRadius="{ThemeResource OverlayCornerRadius}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}" BorderThickness="1">
                            <Grid Width="256" Height="256">
                                <Image Source="{x:Bind ViewModel.QrCodeBytes, Mode=OneWay, Converter={StaticResource ByteArrayToImageSourceConverter}}"
                                       Width="256" Height="256"
                                       Visibility="{x:Bind ViewModel.HasQrCodeBytes, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                                            Visibility="{x:Bind ViewModel.HasQrCodeBytes, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                                    <ProgressRing IsActive="True" Width="44" Height="44" />
                                    <TextBlock Text="Generating QR code..."
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="#666666" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 3. Downloading Recent Messages Screen Overlay (NO doodle background) -->
        <Grid x:Name="SyncingOverlay" Canvas.ZIndex="60"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              Visibility="{x:Bind ViewModel.IsInitialSyncing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RenderTransform>
                <CompositeTransform x:Name="SyncingTransform" />
            </Grid.RenderTransform>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20" MaxWidth="360">
                <!-- Theme-aware grey WhatsApp logo -->
                <Viewbox Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Canvas Width="720" Height="720">
                        <Path Fill="{ThemeResource SyncingWhatsAppLogoBrush}"
                              Data="M360,0C161.18,0,0,161.18,0,360c0,65.41,17.45,126.75,47.94,179.61L0,720l187.02-44.21c51.34,28.18,110.28,44.21,172.98,44.21,198.82,0,360-161.18,360-360S558.82,0,360,0ZM360,655.52c-60.17,0-116.13-17.98-162.82-48.87l-110.49,28.14,30.99-105.61c-33.53-47.93-53.2-106.26-53.2-169.19,0-163.21,132.31-295.52,295.52-295.52s295.52,132.31,295.52,295.52-132.31,295.52-295.52,295.52Z M444.35,407.52l87.1,41.06c4,1.88,6.56,5.94,6.2,10.34-.94,11.46-5.54,34.43-26.13,55.02-58.12,58.12-162.49-7.64-166.74-10.18-25.67-13.79-50.06-32.24-73.19-55.36-23.12-23.12-41.58-47.52-55.37-73.19-2.55-4.24-68.31-108.61-10.18-166.74,20.59-20.59,43.56-25.19,55.02-26.13,4.41-.36,8.46,2.2,10.34,6.2l41.07,87.1c1.94,4.12,1.09,9.02-2.13,12.24l-30.61,30.61c-6.62,6.62-8.56,16.93-4,25.11,11.17,20.03,26.19,39.32,43.59,57.07,17.75,17.4,37.04,32.43,57.07,43.59,8.18,4.56,18.48,2.62,25.11-4l30.61-30.61c3.22-3.22,8.12-4.08,12.24-2.13Z" />
                    </Canvas>
                </Viewbox>

                <!-- "Downloading your recent messages" text ABOVE the progress bar -->
                <TextBlock Text="{x:Bind ViewModel.InitialSyncText, Mode=OneWay}"
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />

                <!-- Progress bar BELOW the text -->
                <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsInitialSyncIndeterminate, Mode=OneWay}"
                             Value="{x:Bind ViewModel.InitialSyncProgress, Mode=OneWay}"
                             Maximum="100"
                             Width="260"
                             Foreground="{ThemeResource AppAccentBrush}"
                             HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Error Overlay (only when blocking with no chats loaded) -->
        <Grid x:Name="ErrorOverlay" Canvas.ZIndex="70"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              Visibility="{x:Bind ViewModel.HasBlockingError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="360">
                <FontIcon Glyph="&#xE783;" FontSize="48" Foreground="{ThemeResource SystemFillColorCautionBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="WhatsApp Connection Failed" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button Content="Retry" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.RetryConnectCommand}" />
                    <Button Content="Use Testing Mode" Command="{x:Bind ViewModel.UseTestingModeCommand}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>

