<Page
    x:Class="People.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Uid="SettingsTitle" Style="{ThemeResource TitleTextBlockStyle}" Margin="16,16,16,16" />

        <ScrollViewer Grid.Row="1" Padding="16,0,16,16" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>


            <!-- Appearance Section -->
            <StackPanel Spacing="2">
                <TextBlock x:Uid="AppearanceHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
                
                <ui:SettingsExpander x:Uid="AppThemeExpander" Header="App theme">
                    <ui:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </ui:SettingsExpander.HeaderIcon>
                    <ui:SettingsExpander.Content>
                        <TextBlock Text="{x:Bind ViewModel.SelectedThemeDisplay, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </ui:SettingsExpander.Content>
                    <ui:SettingsExpander.Items>
                        <RadioButtons SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}" Margin="16,16,16,16">
                            <RadioButton x:Uid="ThemeLightRadio" Content="Light" Tag="Light" />
                            <RadioButton x:Uid="ThemeDarkRadio" Content="Dark" Tag="Dark" />
                            <RadioButton x:Uid="UseSystemSettingThemeRadio" Content="Use system setting" Tag="Default" />
                        </RadioButtons>
                    </ui:SettingsExpander.Items>
                </ui:SettingsExpander>

                <ui:SettingsExpander x:Uid="WindowBackdropExpander" Header="Window Backdrop" Margin="0,2,0,0">
                    <ui:SettingsExpander.Content>
                        <TextBlock Text="{x:Bind ViewModel.SelectedBackdropDisplay, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </ui:SettingsExpander.Content>
                    <ui:SettingsExpander.Items>
                        <RadioButtons SelectedIndex="{x:Bind ViewModel.SelectedBackdropIndex, Mode=TwoWay}" Margin="16,16,16,16">
                            <RadioButton x:Uid="BackdropMicaRadio" Content="Mica" />
                            <RadioButton x:Uid="BackdropAcrylicRadio" Content="Acrylic" />
                            <RadioButton x:Uid="BackdropMicaAltRadio" Content="Mica Alt" />
                            <RadioButton x:Uid="BackdropNoneRadio" Content="None" />
                        </RadioButtons>
                    </ui:SettingsExpander.Items>
                </ui:SettingsExpander>
            </StackPanel>

            <!-- Platforms Section -->
            <StackPanel Spacing="2">
                <TextBlock x:Uid="PlatformsHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
                
                <!-- WhatsApp -->
                <ui:SettingsExpander x:Uid="WhatsAppExpander">
                    <ui:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE815;" />
                    </ui:SettingsExpander.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsWhatsAppEnabled, Mode=TwoWay}" AutomationProperties.Name="WhatsApp enabled" AutomationProperties.AutomationId="WhatsAppToggle" />
                    
                    <ui:SettingsExpander.Items>
                        <ui:SettingsCard Header="Authentication" Description="Re-authenticate your WhatsApp session">
                            <Button x:Uid="ReauthBtn" Command="{x:Bind ViewModel.ReauthenticateCommand}" Style="{ThemeResource AccentButtonStyle}" AutomationProperties.Name="Re-authenticate WhatsApp" AutomationProperties.AutomationId="ReauthBtn" />
                        </ui:SettingsCard>
                        <ui:SettingsCard Header="Accent colour">
                            <ui:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE790;" />
                            </ui:SettingsCard.HeaderIcon>
                            <Expander x:Uid="WhatsAppAccentColorExpander">
                                <Expander.Header>
                                    <TextBlock Text="{x:Bind ViewModel.WhatsAppBubbleColorDisplay, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Expander.Header>
                                <RadioButtons SelectedIndex="{x:Bind ViewModel.WhatsAppBubbleColorIndex, Mode=TwoWay}" Margin="0,8,0,0">
                                    <RadioButton x:Uid="WhatsAppBrandRadio" Content="WhatsApp (default colour scheme)" />
                                    <RadioButton x:Uid="UseSystemSettingWhatsAppRadio" Content="Use system setting" />
                                </RadioButtons>
                            </Expander>
                        </ui:SettingsCard>
                    </ui:SettingsExpander.Items>
                </ui:SettingsExpander>

                <!-- SMS -->
                <ui:SettingsExpander x:Uid="SmsExpander" IsEnabled="False" Margin="0,2,0,0">
                    <ui:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8BD;" />
                    </ui:SettingsExpander.HeaderIcon>
                    <Border Background="{ThemeResource SystemFillColorCautionBrush}" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="4,4">
                        <TextBlock x:Uid="ComingSoonBadge" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Border>
                    <ui:SettingsExpander.Items>
                        <ui:SettingsExpander x:Uid="SmsAccentColorExpander" Header="Accent colour">
                            <ui:SettingsExpander.HeaderIcon>
                                <FontIcon Glyph="&#xE790;" />
                            </ui:SettingsExpander.HeaderIcon>
                            <ui:SettingsExpander.Content>
                                <TextBlock Text="{x:Bind ViewModel.SmsBubbleColorDisplay, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </ui:SettingsExpander.Content>
                            <ui:SettingsExpander.Items>
                                <RadioButtons SelectedIndex="{x:Bind ViewModel.SmsBubbleColorIndex, Mode=TwoWay}" Margin="16,16,16,16">
                                    <RadioButton x:Uid="SmsBrandRadio" Content="SMS (default colour scheme)" />
                                    <RadioButton x:Uid="UseSystemSettingSmsRadio" Content="Use system setting" />
                                </RadioButtons>
                            </ui:SettingsExpander.Items>
                        </ui:SettingsExpander>
                    </ui:SettingsExpander.Items>
                </ui:SettingsExpander>

                <!-- Telegram -->
                <ui:SettingsExpander x:Uid="TelegramExpander" IsEnabled="False" Margin="0,2,0,0">
                    <ui:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </ui:SettingsExpander.HeaderIcon>
                    
                    <ui:SettingsExpander.Items>
                        <ui:SettingsExpander x:Uid="TelegramAccentColorExpander" Header="Accent colour">
                            <ui:SettingsExpander.HeaderIcon>
                                <FontIcon Glyph="&#xE790;" />
                            </ui:SettingsExpander.HeaderIcon>
                            <ui:SettingsExpander.Content>
                                <TextBlock Text="{x:Bind ViewModel.TelegramBubbleColorDisplay, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </ui:SettingsExpander.Content>
                            <ui:SettingsExpander.Items>
                                <RadioButtons SelectedIndex="{x:Bind ViewModel.TelegramBubbleColorIndex, Mode=TwoWay}" Margin="16,16,16,16">
                                    <RadioButton x:Uid="TelegramBrandRadio" Content="Telegram (default colour scheme)" />
                                    <RadioButton x:Uid="UseSystemSettingTelegramRadio" Content="Use system setting" />
                                </RadioButtons>
                            </ui:SettingsExpander.Items>
                        </ui:SettingsExpander>
                    </ui:SettingsExpander.Items>
                </ui:SettingsExpander>

                <!-- Discord -->
                <ui:SettingsExpander x:Uid="DiscordExpander" IsEnabled="False" Margin="0,2,0,0">
                    <ui:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE90A;" />
                    </ui:SettingsExpander.HeaderIcon>
                    <Border Background="{ThemeResource SystemFillColorCautionBrush}" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="4,4">
                        <TextBlock x:Uid="ComingSoonBadge" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Border>
                    <ui:SettingsExpander.Items>
                        <ui:SettingsExpander x:Uid="DiscordAccentColorExpander" Header="Accent colour">
                            <ui:SettingsExpander.HeaderIcon>
                                <FontIcon Glyph="&#xE790;" />
                            </ui:SettingsExpander.HeaderIcon>
                            <ui:SettingsExpander.Content>
                                <TextBlock Text="{x:Bind ViewModel.DiscordBubbleColorDisplay, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </ui:SettingsExpander.Content>
                            <ui:SettingsExpander.Items>
                                <RadioButtons SelectedIndex="{x:Bind ViewModel.DiscordBubbleColorIndex, Mode=TwoWay}" Margin="16,16,16,16">
                                    <RadioButton x:Uid="DiscordBrandRadio" Content="Discord (default colour scheme)" />
                                    <RadioButton x:Uid="UseSystemSettingDiscordRadio" Content="Use system setting" />
                                </RadioButtons>
                            </ui:SettingsExpander.Items>
                        </ui:SettingsExpander>
                    </ui:SettingsExpander.Items>
                </ui:SettingsExpander>

                <!-- Signal -->
                <ui:SettingsExpander x:Uid="SignalExpander" IsEnabled="False" Margin="0,2,0,0">
                    <ui:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </ui:SettingsExpander.HeaderIcon>
                    <Border Background="{ThemeResource SystemFillColorCautionBrush}" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="4,4">
                        <TextBlock x:Uid="ComingSoonBadge" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Border>
                    <ui:SettingsExpander.Items>
                        <ui:SettingsExpander x:Uid="SignalAccentColorExpander" Header="Accent colour">
                            <ui:SettingsExpander.HeaderIcon>
                                <FontIcon Glyph="&#xE790;" />
                            </ui:SettingsExpander.HeaderIcon>
                            <ui:SettingsExpander.Content>
                                <TextBlock Text="{x:Bind ViewModel.SignalBubbleColorDisplay, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </ui:SettingsExpander.Content>
                            <ui:SettingsExpander.Items>
                                <RadioButtons SelectedIndex="{x:Bind ViewModel.SignalBubbleColorIndex, Mode=TwoWay}" Margin="16,16,16,16">
                                    <RadioButton x:Uid="SignalBrandRadio" Content="Signal (default colour scheme)" />
                                    <RadioButton x:Uid="UseSystemSettingSignalRadio" Content="Use system setting" />
                                </RadioButtons>
                            </ui:SettingsExpander.Items>
                        </ui:SettingsExpander>
                    </ui:SettingsExpander.Items>
                </ui:SettingsExpander>
            </StackPanel>

            <!-- Taskbar & Notifications -->
            <StackPanel Spacing="2">
                <TextBlock x:Uid="TaskbarHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
                
                <ui:SettingsExpander x:Uid="TrayExpander">
                    <ui:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8A1;" />
                    </ui:SettingsExpander.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsFlyoutEnabled, Mode=TwoWay}" AutomationProperties.Name="Tray icon enabled" AutomationProperties.AutomationId="TrayToggle" />
                    
                    <ui:SettingsExpander.Items>
                        <ui:SettingsCard Header="Unread Badge" Description="Show unread message count in tray">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.ShowUnreadBadge, Mode=TwoWay}" AutomationProperties.Name="Show unread badge" AutomationProperties.AutomationId="BadgeToggle" />
                        </ui:SettingsCard>
                        <ui:SettingsCard Header="Test Notifications" Description="Send a sample notification">
                            <Button x:Uid="TestBtn" Command="{x:Bind ViewModel.TestNotificationCommand}" AutomationProperties.Name="Test notifications" AutomationProperties.AutomationId="TestNotifBtn" />
                        </ui:SettingsCard>
                    </ui:SettingsExpander.Items>
                </ui:SettingsExpander>
            </StackPanel>

            <!-- About -->
            <StackPanel Spacing="2">
                <TextBlock x:Uid="AboutHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
                
                <ui:SettingsCard x:Uid="AboutCard">
                    <ui:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE946;" />
                    </ui:SettingsCard.HeaderIcon>
                    <HyperlinkButton Content="Check for Updates" AutomationProperties.Name="Check for updates" AutomationProperties.AutomationId="UpdateBtn" />
                </ui:SettingsCard>
            </StackPanel>
            
        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>



