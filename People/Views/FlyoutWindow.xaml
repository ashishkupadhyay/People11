<Window
    x:Class="People.Views.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="People Flyout">
    
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" X="0" Y="0" />
        </Grid.RenderTransform>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
        </Grid.KeyboardAccelerators>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Flyout Header Bar -->
        <Border x:Name="FlyoutHeaderBar" Grid.Row="0" Background="Transparent" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Back button when viewing a conversation inside the flyout -->
                    <Button x:Name="FlyoutBackButton" Click="FlyoutBackButton_Click"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Visibility="Collapsed"
                            Padding="6,6"
                            ToolTipService.ToolTip="Back to chats"
                            AutomationProperties.AutomationId="FlyoutBackBtn">
                        <FontIcon Glyph="&#xE72B;" FontSize="12" />
                    </Button>

                    <!-- Divided Platform Button (Neutral Fluent styling, no accent color) -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <!-- Part 1: Platform Name Button (Click to open in main app) -->
                            <Button x:Name="PlatformNameButton"
                                    Click="PlatformNameButton_Click"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    CornerRadius="3,0,0,3"
                                    BorderThickness="0"
                                    Padding="10,5"
                                    ToolTipService.ToolTip="Open in main app"
                                    AutomationProperties.AutomationId="FlyoutPlatformNameBtn">
                                <TextBlock x:Name="PlatformNameText" Text="WhatsApp" FontWeight="SemiBold" FontSize="13" />
                            </Button>

                            <!-- Subtle Vertical Divider -->
                            <Rectangle Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,3" />

                            <!-- Part 2: Rightward Chevron Button (Click to open available platforms menu) -->
                            <Button x:Name="PlatformChevronButton"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    CornerRadius="0,3,3,0"
                                    BorderThickness="0"
                                    Padding="6,5"
                                    ToolTipService.ToolTip="Select platform"
                                    AutomationProperties.AutomationId="FlyoutPlatformChevronBtn">
                                <FontIcon Glyph="&#xE76C;" FontSize="10" />
                                <Button.Flyout>
                                    <MenuFlyout x:Name="PlatformMenuFlyout">
                                        <MenuFlyoutItem Text="WhatsApp" Tag="WhatsApp" Click="PlatformMenuItem_Click" />
                                        <MenuFlyoutItem Text="Telegram" Tag="Telegram" Click="PlatformMenuItem_Click" />
                                        <MenuFlyoutItem Text="Discord" Tag="Discord" Click="PlatformMenuItem_Click" />
                                        <MenuFlyoutItem Text="Signal" Tag="Signal" Click="PlatformMenuItem_Click" />
                                        <MenuFlyoutItem Text="SMS" Tag="SMS" Click="PlatformMenuItem_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Frame x:Name="ContentFrame" Grid.Row="1" />
    </Grid>
</Window>
