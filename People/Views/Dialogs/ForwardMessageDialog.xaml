<ContentDialog
    x:Class="People.Views.Dialogs.ForwardMessageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:People.Converters"
    xmlns:models="using:People.Core.Models"
    mc:Ignorable="d"
    Title="Forward message"
    PrimaryButtonText="Forward"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter" />
        <converters:PersonPictureDisplayNameConverter x:Key="PersonPictureDisplayNameConverter" />
    </ContentDialog.Resources>

    <StackPanel Spacing="12" Width="{x:Bind DialogWidth}">
        <AutoSuggestBox x:Name="SearchBox"
                        PlaceholderText="Search contacts..."
                        QueryIcon="Find"
                        HorizontalAlignment="Stretch"
                        TextChanged="SearchBox_TextChanged" />

        <Grid>
            <ListView x:Name="ChatsListView"
                      ItemsSource="{x:Bind FilteredChats}"
                      SelectionMode="Single"
                      MaxHeight="320"
                      MinHeight="180"
                      IsItemClickEnabled="True"
                      SelectionChanged="ChatsListView_SelectionChanged"
                      ItemClick="ChatsListView_ItemClick"
                      DoubleTapped="ChatsListView_DoubleTapped">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Chat">
                        <Grid Padding="4,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <PersonPicture Grid.Column="0"
                                           Width="38"
                                           Height="38"
                                           VerticalAlignment="Center"
                                           ProfilePicture="{x:Bind PictureUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=Avatar}"
                                           IsGroup="{x:Bind ShowGroupPlaceholder, Mode=OneWay}"
                                           Initials="{x:Bind Initials, Mode=OneWay}"
                                           DisplayName="{x:Bind Title, Mode=OneWay, Converter={StaticResource PersonPictureDisplayNameConverter}}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind Title, Mode=OneWay}"
                                       FontWeight="Medium"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="EmptyText"
                       Text="No contacts found"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="Collapsed"
                       Margin="0,40,0,40" />
        </Grid>
    </StackPanel>
</ContentDialog>
