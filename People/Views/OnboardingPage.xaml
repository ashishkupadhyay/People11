<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="People.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:People.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Dark Mode Theme Palette (Standard WinUI window dark mode grey #202020 with atmospheric glow cover overlay) -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="OnboardingBaseBackgroundBrush" Color="#202020" />

                    <RadialGradientBrush x:Key="OnboardingGlowOverlayBrush"
                                         Center="0.5, 1.0"
                                         GradientOrigin="0.5, 1.0"
                                         RadiusX="1.0" RadiusY="0.68">
                        <!-- Bottom Center: Dense Luminous Atmosphere behind text -->
                        <GradientStop Color="#FF484E60" Offset="0.00" />
                        <!-- Row 1 Lower: Atmospheric Glow behind text -->
                        <GradientStop Color="#DC383E4E" Offset="0.30" />
                        <!-- Canopy Lower Tier: Covers lower images (62% veil) -->
                        <GradientStop Color="#9E2E3340" Offset="0.55" />
                        <!-- Canopy Mid Tier: Soft 30% translucent emergence -->
                        <GradientStop Color="#4D252830" Offset="0.75" />
                        <!-- Canopy Upper Transition: Gentle 10% feather -->
                        <GradientStop Color="#1A202020" Offset="0.90" />
                        <!-- Canopy Top & Crown: 100% Clear & Pristine -->
                        <GradientStop Color="#00202020" Offset="1.00" />
                    </RadialGradientBrush>

                    <SolidColorBrush x:Key="GetStartedBtnBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="GetStartedBtnForeground" Color="#121214" />
                    <SolidColorBrush x:Key="GetStartedBtnBorderBrush" Color="#E0E0E0" />

                    <SolidColorBrush x:Key="GetStartedBtnBackgroundPointerOver" Color="#E2E2E6" />
                    <SolidColorBrush x:Key="GetStartedBtnBorderPointerOver" Color="#C0C0C6" />
                    <SolidColorBrush x:Key="GetStartedBtnForegroundPointerOver" Color="#000000" />

                    <SolidColorBrush x:Key="GetStartedBtnBackgroundPressed" Color="#C6C6CC" />
                    <SolidColorBrush x:Key="GetStartedBtnBorderPressed" Color="#A8A8B0" />
                    <SolidColorBrush x:Key="GetStartedBtnForegroundPressed" Color="#000000" />
                </ResourceDictionary>

                <!-- Light Mode Theme Palette (Clean Light Window Surface with atmospheric glow cover overlay) -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="OnboardingBaseBackgroundBrush" Color="#F5F6F8" />

                    <RadialGradientBrush x:Key="OnboardingGlowOverlayBrush"
                                         Center="0.5, 1.0"
                                         GradientOrigin="0.5, 1.0"
                                         RadiusX="1.0" RadiusY="0.68">
                        <!-- Bottom Center: Cool Silver/Slate Fluent Glow -->
                        <GradientStop Color="#FFB4BCD0" Offset="0.00" />
                        <!-- Row 1 Lower: Smooth Light Atmosphere behind text -->
                        <GradientStop Color="#D9BCC5D6" Offset="0.30" />
                        <!-- Canopy Lower Tier: Covers lower images (60% veil) -->
                        <GradientStop Color="#99CBD2DF" Offset="0.55" />
                        <!-- Canopy Mid Tier: Soft 30% translucent emergence -->
                        <GradientStop Color="#4DDBE0EB" Offset="0.75" />
                        <!-- Canopy Upper Transition: Gentle 10% feather -->
                        <GradientStop Color="#1AF5F6F8" Offset="0.90" />
                        <!-- Canopy Top & Crown: 100% Clear & Pristine -->
                        <GradientStop Color="#00F5F6F8" Offset="1.00" />
                    </RadialGradientBrush>

                    <SolidColorBrush x:Key="GetStartedBtnBackground" Color="#2C2C2E" />
                    <SolidColorBrush x:Key="GetStartedBtnForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="GetStartedBtnBorderBrush" Color="#222224" />

                    <SolidColorBrush x:Key="GetStartedBtnBackgroundPointerOver" Color="#48484E" />
                    <SolidColorBrush x:Key="GetStartedBtnBorderPointerOver" Color="#666670" />
                    <SolidColorBrush x:Key="GetStartedBtnForegroundPointerOver" Color="#FFFFFF" />

                    <SolidColorBrush x:Key="GetStartedBtnBackgroundPressed" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="GetStartedBtnBorderPressed" Color="#121214" />
                    <SolidColorBrush x:Key="GetStartedBtnForegroundPressed" Color="#FFFFFF" />
                </ResourceDictionary>

                <!-- High Contrast Theme Palette -->
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="OnboardingBaseBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="OnboardingGlowOverlayBrush" Color="Transparent" />

                    <SolidColorBrush x:Key="GetStartedBtnBackground" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="GetStartedBtnForeground" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="GetStartedBtnBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />

                    <SolidColorBrush x:Key="GetStartedBtnBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="GetStartedBtnBorderPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="GetStartedBtnForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />

                    <SolidColorBrush x:Key="GetStartedBtnBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="GetStartedBtnBorderPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="GetStartedBtnForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Fluent Get Started Button Style (Refined Proportions, Clear Hover Highlight, Native CornerRadius) -->
            <Style x:Key="GetStartedButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource GetStartedBtnBackground}" />
                <Setter Property="Foreground" Value="{ThemeResource GetStartedBtnForeground}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GetStartedBtnBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="Padding" Value="22,5,22,6" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{ThemeResource GetStartedBtnBackground}" />
                                                <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource GetStartedBtnBorderBrush}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource GetStartedBtnForeground}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{ThemeResource GetStartedBtnBackgroundPointerOver}" />
                                                <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource GetStartedBtnBorderPointerOver}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource GetStartedBtnForegroundPointerOver}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{ThemeResource GetStartedBtnBackgroundPressed}" />
                                                <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource GetStartedBtnBorderPressed}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource GetStartedBtnForegroundPressed}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <!-- Root Grid fills 100% of window with solid base surface background -->
    <Grid Background="{ThemeResource OnboardingBaseBackgroundBrush}">
        <!-- Transparent Draggable TitleBar Region for full-window drag -->
        <Grid x:Name="OnboardingTitleBar"
              Height="48"
              VerticalAlignment="Top"
              Background="Transparent"
              Canvas.ZIndex="20" />

        <!-- Main Onboarding Content Layout -->
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <!-- Row 0: Collage Canopy placed higher up -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Text & Action Button with breathing room below -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Row 0: Continuous 2400px Circular Profile Constellation Canopy (ZIndex=0: base image layer) -->
            <Grid Grid.Row="0"
                  x:Name="CanopyHost"
                  Canvas.ZIndex="0"
                  HorizontalAlignment="Stretch"
                  Height="360"
                  Margin="0,32,0,0">
                <Canvas x:Name="CanopyCanvas"
                        Width="2400" Height="360"
                        HorizontalAlignment="Center"
                        Opacity="0">

                    <!-- ============================================================ -->
                    <!-- LEFT CONTINUOUS TILING (Cols 1-4, X = 451.8 to 825.9)        -->
                    <!-- ============================================================ -->
                    <!-- Col 1 (Far Left Flank: repeats Cols 11/12 with ~1372px distance) -->
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture16.png" Width="116" Height="116" Canvas.Left="393.8" Canvas.Top="14.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture27.png" Width="116" Height="116" Canvas.Left="393.8" Canvas.Top="158.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture28.png" Width="116" Height="116" Canvas.Left="393.8" Canvas.Top="302.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />

                    <!-- Col 2 -->
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture1.png" Width="116" Height="116" Canvas.Left="518.5" Canvas.Top="-58.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture10.png" Width="116" Height="116" Canvas.Left="518.5" Canvas.Top="86.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture13.png" Width="116" Height="116" Canvas.Left="518.5" Canvas.Top="230.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />

                    <!-- Col 3 -->
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture17.png" Width="116" Height="116" Canvas.Left="643.2" Canvas.Top="14.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture22.png" Width="116" Height="116" Canvas.Left="643.2" Canvas.Top="158.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture14.png" Width="116" Height="116" Canvas.Left="643.2" Canvas.Top="302.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />

                    <!-- Col 4 -->
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture29.png" Width="116" Height="116" Canvas.Left="767.9" Canvas.Top="-58.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture9.png" Width="116" Height="116" Canvas.Left="767.9" Canvas.Top="86.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture15.png" Width="116" Height="116" Canvas.Left="767.9" Canvas.Top="230.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />

                    <!-- ============================================================ -->
                    <!-- CENTER ARCH CLUSTER (Cols 5-9, X = 950.6 to 1449.4, center X=1200) -->
                    <!-- ============================================================ -->
                    <!-- Col 5 -->
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture4.png" Width="116" Height="116" Canvas.Left="892.6" Canvas.Top="14.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture19.png" Width="116" Height="116" Canvas.Left="892.6" Canvas.Top="158.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture21.png" Width="116" Height="116" Canvas.Left="892.6" Canvas.Top="302.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />

                    <!-- Col 6 (Arch Left Wing) -->
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture30.png" Width="116" Height="116" Canvas.Left="1017.3" Canvas.Top="-58.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture5.png" Width="116" Height="116" Canvas.Left="1017.3" Canvas.Top="86.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture11.png" Width="116" Height="116" Canvas.Left="1017.3" Canvas.Top="230.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />

                    <!-- Col 7 (Arch Crown Keystone, Midpoint, and Lower Center) -->
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture6.png" Width="116" Height="116" Canvas.Left="1142.0" Canvas.Top="14.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture12.png" Width="116" Height="116" Canvas.Left="1142.0" Canvas.Top="158.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture16.png" Width="116" Height="116" Canvas.Left="1142.0" Canvas.Top="302.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />

                    <!-- Col 8 (Arch Right Wing) -->
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture13.png" Width="116" Height="116" Canvas.Left="1266.7" Canvas.Top="-58.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture2.png" Width="116" Height="116" Canvas.Left="1266.7" Canvas.Top="86.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture8.png" Width="116" Height="116" Canvas.Left="1266.7" Canvas.Top="230.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />

                    <!-- Col 9 -->
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture18.png" Width="116" Height="116" Canvas.Left="1391.4" Canvas.Top="14.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture24.png" Width="116" Height="116" Canvas.Left="1391.4" Canvas.Top="158.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture3.png" Width="116" Height="116" Canvas.Left="1391.4" Canvas.Top="302.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />

                    <!-- ============================================================ -->
                    <!-- RIGHT CONTINUOUS TILING (Cols 10-13, X = 1574.1 to 1948.3)   -->
                    <!-- ============================================================ -->
                    <!-- Col 10 -->
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture7.png" Width="116" Height="116" Canvas.Left="1516.1" Canvas.Top="-58.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture25.png" Width="116" Height="116" Canvas.Left="1516.1" Canvas.Top="86.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture30.png" Width="116" Height="116" Canvas.Left="1516.1" Canvas.Top="230.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />

                    <!-- Col 11 -->
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture20.png" Width="116" Height="116" Canvas.Left="1640.8" Canvas.Top="14.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture26.png" Width="116" Height="116" Canvas.Left="1640.8" Canvas.Top="158.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture23.png" Width="116" Height="116" Canvas.Left="1640.8" Canvas.Top="302.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />

                    <!-- Col 12 -->
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture16.png" Width="116" Height="116" Canvas.Left="1765.5" Canvas.Top="-58.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture27.png" Width="116" Height="116" Canvas.Left="1765.5" Canvas.Top="86.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture28.png" Width="116" Height="116" Canvas.Left="1765.5" Canvas.Top="230.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />

                    <!-- Col 13 (Far Right Flank: repeats Col 2 with ~1372px distance) -->
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture1.png" Width="116" Height="116" Canvas.Left="1890.2" Canvas.Top="14.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture19.png" Width="116" Height="116" Canvas.Left="1890.2" Canvas.Top="158.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture13.png" Width="116" Height="116" Canvas.Left="1890.2" Canvas.Top="302.0" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                </Canvas>
            </Grid>

            <!-- Atmospheric Glow Overlay (ZIndex="5": covers lower canopy images, fading out towards the top) -->
            <Rectangle Grid.Row="0"
                       Grid.RowSpan="2"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Canvas.ZIndex="5"
                       IsHitTestVisible="False"
                       Fill="{ThemeResource OnboardingGlowOverlayBrush}" />

            <!-- Row 1: Text & Call-To-Action Button (Foreground Layer: ZIndex=10) -->
            <StackPanel Grid.Row="1"
                        Canvas.ZIndex="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="24,0"
                        Margin="0,0,0,40">
                <TextBlock Text="People"
                           Style="{ThemeResource TitleLargeTextBlockStyle}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,6" />

                <TextBlock Text="Chat across WhatsApp, SMS, Telegram, Signal, and Discord in a single app."
                           Style="{ThemeResource BodyLargeTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           MaxWidth="520"
                           TextWrapping="Wrap"
                           Margin="0,0,0,22" />

                <Button x:Name="GetStartedButton"
                        Click="GetStartedButton_Click"
                        Content="Get started"
                        Style="{StaticResource GetStartedButtonStyle}"
                        AutomationProperties.AutomationId="GetStartedBtn"
                        AutomationProperties.Name="Get started" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
