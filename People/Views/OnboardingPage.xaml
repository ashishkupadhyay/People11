<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="People.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:People.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    SizeChanged="OnboardingPage_SizeChanged">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Dark Mode Theme Palette (Standard WinUI window dark mode grey #202020 with curved bow-shaped atmospheric glow cover overlay) -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="OnboardingBaseBackgroundBrush" Color="#202020" />

                    <RadialGradientBrush x:Key="OnboardingGlowOverlayBrush"
                                         Center="0.5, 1.0"
                                         GradientOrigin="0.5, 1.0"
                                         RadiusX="0.55" RadiusY="0.80">
                        <!-- Bottom Center: Dense Luminous Core behind text -->
                        <GradientStop Color="#FF464C5E" Offset="0.00" />
                        <!-- Row 1 Lower: Solid Atmosphere behind text & button -->
                        <GradientStop Color="#FF343A48" Offset="0.25" />
                        <!-- Dense Shadow Bed (96% opaque veil over lower canopy) -->
                        <GradientStop Color="#F5282C37" Offset="0.45" />
                        <!-- Canopy Mid-Lower Tier: 80% opaque dark shadow veil -->
                        <GradientStop Color="#CC22242D" Offset="0.65" />
                        <!-- Canopy Mid Tier: 40% soft translucent emergence -->
                        <GradientStop Color="#66202020" Offset="0.82" />
                        <!-- Canopy Upper Transition: Gentle 10% feather -->
                        <GradientStop Color="#1A202020" Offset="0.93" />
                        <!-- Canopy Top & Crown: 100% Clear & Pristine -->
                        <GradientStop Color="#00202020" Offset="1.00" />
                    </RadialGradientBrush>

                    <SolidColorBrush x:Key="GetStartedBtnBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="GetStartedBtnForeground" Color="#121214" />
                    <SolidColorBrush x:Key="GetStartedBtnBorderBrush" Color="#E0E0E0" />

                    <SolidColorBrush x:Key="GetStartedBtnBackgroundPointerOver" Color="#E2E2E6" />
                    <SolidColorBrush x:Key="GetStartedBtnBorderPointerOver" Color="#C0C0C6" />
                    <SolidColorBrush x:Key="GetStartedBtnForegroundPointerOver" Color="#000000" />

                    <SolidColorBrush x:Key="GetStartedBtnBackgroundPressed" Color="#C6C6CC" />
                    <SolidColorBrush x:Key="GetStartedBtnBorderPressed" Color="#A8A8B0" />
                    <SolidColorBrush x:Key="GetStartedBtnForegroundPressed" Color="#000000" />
                </ResourceDictionary>

                <!-- Light Mode Theme Palette (Clean Light Window Surface with curved bow-shaped atmospheric glow shadow overlay) -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="OnboardingBaseBackgroundBrush" Color="#F5F6F8" />

                    <RadialGradientBrush x:Key="OnboardingGlowOverlayBrush"
                                         Center="0.5, 1.0"
                                         GradientOrigin="0.5, 1.0"
                                         RadiusX="0.55" RadiusY="0.80">
                        <!-- Bottom Center: Rich Cool Slate Shadow Core -->
                        <GradientStop Color="#FFA6B0C4" Offset="0.00" />
                        <!-- Row 1 Lower: Solid Cool Shadow Atmosphere behind text & button -->
                        <GradientStop Color="#FFB4BED2" Offset="0.25" />
                        <!-- Dense Shadow Bed (96% opaque veil over lower canopy) -->
                        <GradientStop Color="#F5C2CCDC" Offset="0.45" />
                        <!-- Canopy Mid-Lower Tier: 80% opaque cool shadow veil -->
                        <GradientStop Color="#CCD0DAE6" Offset="0.65" />
                        <!-- Canopy Mid Tier: 40% soft translucent emergence -->
                        <GradientStop Color="#66DFE4EE" Offset="0.82" />
                        <!-- Canopy Upper Transition: Gentle 10% feather to window surface -->
                        <GradientStop Color="#1AF5F6F8" Offset="0.93" />
                        <!-- Canopy Top & Crown: 100% Clear & Pristine -->
                        <GradientStop Color="#00F5F6F8" Offset="1.00" />
                    </RadialGradientBrush>

                    <SolidColorBrush x:Key="GetStartedBtnBackground" Color="#2C2C2E" />
                    <SolidColorBrush x:Key="GetStartedBtnForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="GetStartedBtnBorderBrush" Color="#222224" />

                    <SolidColorBrush x:Key="GetStartedBtnBackgroundPointerOver" Color="#48484E" />
                    <SolidColorBrush x:Key="GetStartedBtnBorderPointerOver" Color="#666670" />
                    <SolidColorBrush x:Key="GetStartedBtnForegroundPointerOver" Color="#FFFFFF" />

                    <SolidColorBrush x:Key="GetStartedBtnBackgroundPressed" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="GetStartedBtnBorderPressed" Color="#121214" />
                    <SolidColorBrush x:Key="GetStartedBtnForegroundPressed" Color="#FFFFFF" />
                </ResourceDictionary>

                <!-- High Contrast Theme Palette -->
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="OnboardingBaseBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="OnboardingGlowOverlayBrush" Color="Transparent" />

                    <SolidColorBrush x:Key="GetStartedBtnBackground" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="GetStartedBtnForeground" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="GetStartedBtnBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />

                    <SolidColorBrush x:Key="GetStartedBtnBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="GetStartedBtnBorderPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="GetStartedBtnForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />

                    <SolidColorBrush x:Key="GetStartedBtnBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="GetStartedBtnBorderPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="GetStartedBtnForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Fluent Get Started Button Style (Refined Proportions, Clear Hover Highlight, Native CornerRadius) -->
            <Style x:Key="GetStartedButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource GetStartedBtnBackground}" />
                <Setter Property="Foreground" Value="{ThemeResource GetStartedBtnForeground}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GetStartedBtnBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="Padding" Value="22,5,22,6" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{ThemeResource GetStartedBtnBackground}" />
                                                <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource GetStartedBtnBorderBrush}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource GetStartedBtnForeground}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{ThemeResource GetStartedBtnBackgroundPointerOver}" />
                                                <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource GetStartedBtnBorderPointerOver}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource GetStartedBtnForegroundPointerOver}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{ThemeResource GetStartedBtnBackgroundPressed}" />
                                                <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource GetStartedBtnBorderPressed}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource GetStartedBtnForegroundPressed}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <!-- Root Grid fills 100% of window with solid base surface background -->
    <Grid Background="{ThemeResource OnboardingBaseBackgroundBrush}">
        <!-- Transparent Draggable TitleBar Region for full-window drag -->
        <Grid x:Name="OnboardingTitleBar"
              Height="48"
              VerticalAlignment="Top"
              Background="Transparent"
              Canvas.ZIndex="20" />

        <!-- Main Onboarding Content Layout -->
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <!-- Row 0: Fixed 360px upper viewport boundary for top canopy tiers -->
                <RowDefinition Height="360" />
                <!-- Row 1: Responsive lower viewport for text, CTA button, and lower expanding columns -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Continuous Hexagonal Profile Constellation Canopy (ZIndex=0: base image layer, dynamically populated in C#) -->
            <Grid Grid.Row="0"
                  Grid.RowSpan="2"
                  x:Name="CanopyHost"
                  Canvas.ZIndex="0"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Margin="0,32,0,0">
                <Canvas x:Name="CanopyCanvas"
                        Width="4000" Height="2400"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Opacity="0" />
            </Grid>

            <!-- Atmospheric Glow Overlay (ZIndex="5": covers lower canopy images, fading out towards the top) -->
            <Rectangle Grid.Row="0"
                       Grid.RowSpan="2"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Canvas.ZIndex="5"
                       IsHitTestVisible="False"
                       Fill="{ThemeResource OnboardingGlowOverlayBrush}" />

            <!-- Row 1: Text & Call-To-Action Button (Foreground Layer: ZIndex=10) -->
            <StackPanel Grid.Row="1"
                        Canvas.ZIndex="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="24,0"
                        Margin="0,0,0,40">
                <TextBlock Text="People"
                           Style="{ThemeResource TitleLargeTextBlockStyle}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,16" />

                <TextBlock Text="Chat across WhatsApp, SMS, Telegram, Signal, and Discord in a single app."
                           Style="{ThemeResource BodyLargeTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           MaxWidth="520"
                           TextWrapping="Wrap"
                           Margin="0,0,0,34" />

                <Button x:Name="GetStartedButton"
                        Click="GetStartedButton_Click"
                        Content="Get started"
                        Style="{StaticResource GetStartedButtonStyle}"
                        AutomationProperties.AutomationId="GetStartedBtn"
                        AutomationProperties.Name="Get started" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
