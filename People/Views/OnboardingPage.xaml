<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="People.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:People.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Dark Mode Theme Palette (Standard WinUI window dark mode grey #202020 with bottom-anchored atmospheric glow) -->
                <ResourceDictionary x:Key="Dark">
                    <RadialGradientBrush x:Key="OnboardingWindowGradientBrush"
                                         Center="0.5, 1.0"
                                         GradientOrigin="0.5, 1.0"
                                         RadiusX="1.0" RadiusY="0.58">
                        <GradientStop Color="#484E60" Offset="0.0" />
                        <GradientStop Color="#333744" Offset="0.35" />
                        <GradientStop Color="#26282E" Offset="0.70" />
                        <GradientStop Color="#202020" Offset="1.0" />
                    </RadialGradientBrush>

                    <SolidColorBrush x:Key="GetStartedBtnBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="GetStartedBtnForeground" Color="#121214" />
                    <SolidColorBrush x:Key="GetStartedBtnBorderBrush" Color="#E0E0E0" />

                    <SolidColorBrush x:Key="GetStartedBtnBackgroundPointerOver" Color="#E2E2E6" />
                    <SolidColorBrush x:Key="GetStartedBtnBorderPointerOver" Color="#C0C0C6" />
                    <SolidColorBrush x:Key="GetStartedBtnForegroundPointerOver" Color="#000000" />

                    <SolidColorBrush x:Key="GetStartedBtnBackgroundPressed" Color="#C6C6CC" />
                    <SolidColorBrush x:Key="GetStartedBtnBorderPressed" Color="#A8A8B0" />
                    <SolidColorBrush x:Key="GetStartedBtnForegroundPressed" Color="#000000" />
                </ResourceDictionary>

                <!-- Light Mode Theme Palette (Bottom-anchored distinct greyish glow spanning bottom left-to-right) -->
                <ResourceDictionary x:Key="Light">
                    <RadialGradientBrush x:Key="OnboardingWindowGradientBrush"
                                         Center="0.5, 1.0"
                                         GradientOrigin="0.5, 1.0"
                                         RadiusX="1.0" RadiusY="0.58">
                        <GradientStop Color="#B4BCD0" Offset="0.0" />
                        <GradientStop Color="#CAD1DE" Offset="0.30" />
                        <GradientStop Color="#DFE3EC" Offset="0.60" />
                        <GradientStop Color="#EDF0F5" Offset="0.85" />
                        <GradientStop Color="#F5F6F8" Offset="1.0" />
                    </RadialGradientBrush>

                    <SolidColorBrush x:Key="GetStartedBtnBackground" Color="#2C2C2E" />
                    <SolidColorBrush x:Key="GetStartedBtnForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="GetStartedBtnBorderBrush" Color="#222224" />

                    <SolidColorBrush x:Key="GetStartedBtnBackgroundPointerOver" Color="#48484E" />
                    <SolidColorBrush x:Key="GetStartedBtnBorderPointerOver" Color="#666670" />
                    <SolidColorBrush x:Key="GetStartedBtnForegroundPointerOver" Color="#FFFFFF" />

                    <SolidColorBrush x:Key="GetStartedBtnBackgroundPressed" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="GetStartedBtnBorderPressed" Color="#121214" />
                    <SolidColorBrush x:Key="GetStartedBtnForegroundPressed" Color="#FFFFFF" />
                </ResourceDictionary>

                <!-- High Contrast Theme Palette -->
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="OnboardingWindowGradientBrush" Color="{ThemeResource SystemColorWindowColor}" />

                    <SolidColorBrush x:Key="GetStartedBtnBackground" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="GetStartedBtnForeground" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="GetStartedBtnBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />

                    <SolidColorBrush x:Key="GetStartedBtnBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="GetStartedBtnBorderPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="GetStartedBtnForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />

                    <SolidColorBrush x:Key="GetStartedBtnBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="GetStartedBtnBorderPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="GetStartedBtnForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Fluent Get Started Button Style (Refined Proportions, Clear Hover Highlight, Native CornerRadius) -->
            <Style x:Key="GetStartedButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource GetStartedBtnBackground}" />
                <Setter Property="Foreground" Value="{ThemeResource GetStartedBtnForeground}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GetStartedBtnBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="Padding" Value="22,5,22,6" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{ThemeResource GetStartedBtnBackground}" />
                                                <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource GetStartedBtnBorderBrush}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource GetStartedBtnForeground}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{ThemeResource GetStartedBtnBackgroundPointerOver}" />
                                                <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource GetStartedBtnBorderPointerOver}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource GetStartedBtnForegroundPointerOver}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{ThemeResource GetStartedBtnBackgroundPressed}" />
                                                <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource GetStartedBtnBorderPressed}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource GetStartedBtnForegroundPressed}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <!-- Root Grid fills 100% of window with background gradient -->
    <Grid Background="{ThemeResource OnboardingWindowGradientBrush}">
        <!-- Transparent Draggable TitleBar Region for full-window drag -->
        <Grid x:Name="OnboardingTitleBar"
              Height="48"
              VerticalAlignment="Top"
              Background="Transparent"
              Canvas.ZIndex="20" />

        <!-- Main Onboarding Content Layout -->
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <!-- Row 0: Collage Canopy placed higher up -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Text & Action Button with breathing room below -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Row 0: Continuous 2400px Circular Profile Constellation Canopy (ZIndex=0 so it rises from behind text) -->
            <Grid Grid.Row="0"
                  x:Name="CanopyHost"
                  Canvas.ZIndex="0"
                  HorizontalAlignment="Stretch"
                  Height="360"
                  Margin="0,32,0,0">
                <Canvas x:Name="CanopyCanvas"
                        Width="2400" Height="360"
                        HorizontalAlignment="Center"
                        Opacity="0">

                    <!-- ============================================================ -->
                    <!-- LEFT CONTINUOUS TILING (Cols 1-4, X = 5 to 780)              -->
                    <!-- ============================================================ -->
                    <!-- Col 1 (Far Left Flank: repeats Cols 11/12 with ~1886px distance) -->
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture21.png" Width="116" Height="116" Canvas.Left="127" Canvas.Top="24" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture27.png" Width="114" Height="114" Canvas.Left="5" Canvas.Top="112" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture28.png" Width="116" Height="116" Canvas.Left="78" Canvas.Top="237" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />

                    <!-- Col 2 -->
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture1.png" Width="116" Height="116" Canvas.Left="271" Canvas.Top="28" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture7.png" Width="116" Height="116" Canvas.Left="195" Canvas.Top="152" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture13.png" Width="118" Height="118" Canvas.Left="314" Canvas.Top="242" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />

                    <!-- Col 3 -->
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture2.png" Width="116" Height="116" Canvas.Left="505" Canvas.Top="13" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture8.png" Width="118" Height="118" Canvas.Left="389" Canvas.Top="116" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture14.png" Width="114" Height="114" Canvas.Left="465" Canvas.Top="244" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />

                    <!-- Col 4 -->
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture3.png" Width="118" Height="118" Canvas.Left="660" Canvas.Top="28" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture9.png" Width="114" Height="114" Canvas.Left="572" Canvas.Top="144" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture15.png" Width="116" Height="116" Canvas.Left="694" Canvas.Top="228" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />

                    <!-- ============================================================ -->
                    <!-- CENTER ARCH CLUSTER (Cols 5-9, X = 780 to 1620, center X=1200) -->
                    <!-- ============================================================ -->
                    <!-- Col 5 -->
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture4.png" Width="116" Height="116" Canvas.Left="886" Canvas.Top="11" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture10.png" Width="116" Height="116" Canvas.Left="780" Canvas.Top="112" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture16.png" Width="114" Height="114" Canvas.Left="838" Canvas.Top="244" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />

                    <!-- Col 6 (Arch Left Wing) -->
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture5.png" Width="118" Height="118" Canvas.Left="1015" Canvas.Top="80" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture11.png" Width="116" Height="116" Canvas.Left="980" Canvas.Top="222" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />

                    <!-- Col 7 (Arch Crown Keystone & Suspended Center Midpoint) -->
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture6.png" Width="116" Height="116" Canvas.Left="1142" Canvas.Top="9" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture12.png" Width="112" Height="112" Canvas.Left="1144" Canvas.Top="166" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />

                    <!-- Col 8 (Arch Right Wing) -->
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture17.png" Width="116" Height="116" Canvas.Left="1269" Canvas.Top="80" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture22.png" Width="118" Height="118" Canvas.Left="1302" Canvas.Top="222" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />

                    <!-- Col 9 -->
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture18.png" Width="118" Height="118" Canvas.Left="1396" Canvas.Top="11" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture24.png" Width="118" Height="118" Canvas.Left="1502" Canvas.Top="112" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture29.png" Width="116" Height="116" Canvas.Left="1446" Canvas.Top="244" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />

                    <!-- ============================================================ -->
                    <!-- RIGHT CONTINUOUS TILING (Cols 10-13, X = 1590 to 2395)       -->
                    <!-- ============================================================ -->
                    <!-- Col 10 -->
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture19.png" Width="116" Height="116" Canvas.Left="1624" Canvas.Top="28" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture25.png" Width="118" Height="118" Canvas.Left="1710" Canvas.Top="144" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture30.png" Width="114" Height="114" Canvas.Left="1592" Canvas.Top="228" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />

                    <!-- Col 11 -->
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture20.png" Width="118" Height="118" Canvas.Left="1777" Canvas.Top="13" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture26.png" Width="114" Height="114" Canvas.Left="1897" Canvas.Top="116" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture23.png" Width="116" Height="116" Canvas.Left="1819" Canvas.Top="244" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />

                    <!-- Col 12 -->
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture21.png" Width="116" Height="116" Canvas.Left="2013" Canvas.Top="28" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture27.png" Width="118" Height="118" Canvas.Left="2087" Canvas.Top="152" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture28.png" Width="114" Height="114" Canvas.Left="1972" Canvas.Top="242" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />

                    <!-- Col 13 (Far Right Flank: repeats Col 2 with ~1886px distance) -->
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture1.png" Width="116" Height="116" Canvas.Left="2157" Canvas.Top="24" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture7.png" Width="114" Height="114" Canvas.Left="2281" Canvas.Top="112" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="ms-appx:///Assets/ProfilePictures/ProfilePicture13.png" Width="116" Height="116" Canvas.Left="2206" Canvas.Top="237" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                </Canvas>
            </Grid>

            <!-- Row 1: Text & Call-To-Action Button (Foreground Layer: ZIndex=10) -->
            <StackPanel Grid.Row="1"
                        Canvas.ZIndex="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="24,0"
                        Margin="0,0,0,40">
                <TextBlock Text="People"
                           Style="{ThemeResource TitleLargeTextBlockStyle}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,6" />

                <TextBlock Text="Chat across WhatsApp, SMS, Telegram, Signal, and Discord in a single app."
                           Style="{ThemeResource BodyLargeTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           MaxWidth="520"
                           TextWrapping="Wrap"
                           Margin="0,0,0,22" />

                <Button x:Name="GetStartedButton"
                        Click="GetStartedButton_Click"
                        Content="Get started"
                        Style="{StaticResource GetStartedButtonStyle}"
                        AutomationProperties.AutomationId="GetStartedBtn"
                        AutomationProperties.Name="Get started" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
