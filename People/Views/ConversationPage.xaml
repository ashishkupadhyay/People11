<Page
    x:Class="People.Views.ConversationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:People.Converters"
    xmlns:models="using:People.Core.Models"
    mc:Ignorable="d"
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">

    <Page.Resources>
        <converters:OutgoingAlignmentConverter x:Key="OutgoingAlignmentConverter" />
        <converters:OutgoingBackgroundConverter x:Key="OutgoingBackgroundConverter" />
        <converters:OutgoingTextColorConverter x:Key="OutgoingTextColorConverter" />
        <converters:OutgoingSubtextColorConverter x:Key="OutgoingSubtextColorConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <converters:CollectionToVisibilityConverter x:Key="CollectionToVisibilityConverter" />
        <converters:GroupSenderVisibilityConverter x:Key="GroupSenderVisibilityConverter" />
        <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="AppAccentElevationBorderFocusedBrush" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="16" Background="Transparent" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <PersonPicture DisplayName="{x:Bind ViewModel.CurrentChat.Title, Mode=OneWay}" Width="40" Height="40" />
                <TextBlock Text="{x:Bind ViewModel.CurrentChat.Title, Mode=OneWay}" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            </StackPanel>
        </Border>

        <!-- Messages -->
        <RefreshContainer x:Name="MessagesRefreshContainer" Grid.Row="1" RefreshRequested="MessagesRefreshContainer_RefreshRequested">
            <RefreshContainer.Visualizer>
                <RefreshVisualizer />
            </RefreshContainer.Visualizer>
            <ListView x:Name="MessagesListView" ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}" SelectionMode="None" Padding="16" AutomationProperties.Name="Messages list" AutomationProperties.AutomationId="MessagesListView">
                <ListView.Header>
                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingOlder, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsLoadingOlder, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                  HorizontalAlignment="Center"
                                  Width="24" Height="24" Margin="0,8"
                                  AutomationProperties.Name="Loading older messages" />
                </ListView.Header>
                <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <AddDeleteThemeTransition />
                    <ReorderThemeTransition />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Message">
                    <Grid Margin="0,4" HorizontalAlignment="{x:Bind IsOutgoing, Mode=OneTime, Converter={StaticResource OutgoingAlignmentConverter}}">
                        <StackPanel MaxWidth="480" Spacing="2">
                            <!-- Message Bubble -->
                            <Border Padding="12,8" CornerRadius="{ThemeResource ControlCornerRadius}" 
                                    Background="{x:Bind Converter={StaticResource OutgoingBackgroundConverter}}">
                                <StackPanel Spacing="4">
                                    <!-- Sender Name (for incoming messages in groups) -->
                                    <TextBlock Text="{x:Bind SenderName, Mode=OneTime}"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="{ThemeResource AppAccentBrush}"
                                               Visibility="{x:Bind Converter={StaticResource GroupSenderVisibilityConverter}}"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Quoted / Reply Preview -->
                                    <Border Visibility="{x:Bind QuotedText, Mode=OneTime, Converter={StaticResource StringToVisibilityConverter}}"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource AppAccentBrush}"
                                            BorderThickness="3,0,0,0"
                                            CornerRadius="4"
                                            Padding="8,4"
                                            Margin="0,0,0,4">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind QuotedSender, Mode=OneTime}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource AppAccentBrush}"
                                                       Visibility="{x:Bind QuotedSender, Mode=OneTime, Converter={StaticResource StringToVisibilityConverter}}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind QuotedText, Mode=OneTime}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       MaxLines="2"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Message Text -->
                                    <TextBlock Text="{x:Bind Content.Text, Mode=OneTime}" 
                                               TextWrapping="Wrap" 
                                               Foreground="{x:Bind IsOutgoing, Mode=OneTime, Converter={StaticResource OutgoingTextColorConverter}}" />

                                    <!-- Timestamp and status icon -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" Margin="0,2,0,-2">
                                        <TextBlock Text="{x:Bind FormattedTime, Mode=OneTime}" 
                                                   FontSize="10" 
                                                   Foreground="{x:Bind IsOutgoing, Mode=OneTime, Converter={StaticResource OutgoingSubtextColorConverter}}" />
                                        <FontIcon Glyph="&#xE73E;" FontSize="10"
                                                  Foreground="{x:Bind IsOutgoing, Mode=OneTime, Converter={StaticResource OutgoingSubtextColorConverter}}"
                                                  Visibility="{x:Bind IsOutgoing, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Reaction pills -->
                            <ItemsControl ItemsSource="{x:Bind Reactions, Mode=OneTime}"
                                          Visibility="{x:Bind Reactions, Mode=OneTime, Converter={StaticResource CollectionToVisibilityConverter}}"
                                          HorizontalAlignment="{x:Bind IsOutgoing, Mode=OneTime, Converter={StaticResource OutgoingAlignmentConverter}}"
                                          Margin="4,-4,4,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="6,2">
                                            <TextBlock Text="{x:Bind}" FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        </RefreshContainer>

        <!-- Input Area -->
        <Grid Grid.Row="2" Padding="16" Background="Transparent" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <TextBox Grid.Column="0" Text="{x:Bind ViewModel.MessageText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" x:Uid="TypeMessageInput" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="100" AutomationProperties.Name="Message input box" AutomationProperties.AutomationId="MessageInputBox" />
            <Button Grid.Column="1" Margin="12,0,0,0" Command="{x:Bind ViewModel.SendMessageCommand}" Style="{ThemeResource AppAccentButtonStyle}" VerticalAlignment="Bottom" x:Uid="SendMessageBtn" AutomationProperties.AutomationId="SendBtn">
                <FontIcon Glyph="&#xE122;" />
            </Button>
        </Grid>
    </Grid>
</Page>

