<Page
    x:Class="People.Views.ConversationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:People.Converters"
    xmlns:models="using:People.Core.Models"
    xmlns:helpers="using:People.Helpers"
    xmlns:controls="using:People.Controls"
    mc:Ignorable="d"
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">

    <Page.Resources>
        <converters:OutgoingAlignmentConverter x:Key="OutgoingAlignmentConverter" />
        <converters:OutgoingBackgroundConverter x:Key="OutgoingBackgroundConverter" />
        <converters:OutgoingTextColorConverter x:Key="OutgoingTextColorConverter" />
        <converters:OutgoingSubtextColorConverter x:Key="OutgoingSubtextColorConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <converters:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter" />
        <converters:CollectionToVisibilityConverter x:Key="CollectionToVisibilityConverter" />
        <converters:GroupSenderVisibilityConverter x:Key="GroupSenderVisibilityConverter" />
        <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter" />
        <converters:PersonPictureDisplayNameConverter x:Key="PersonPictureDisplayNameConverter" />
        <converters:QuotedBackgroundConverter x:Key="QuotedBackgroundConverter" />
        <converters:QuotedBorderBrushConverter x:Key="QuotedBorderBrushConverter" />
        <converters:QuotedSenderBrushConverter x:Key="QuotedSenderBrushConverter" />
        <converters:QuotedTextBrushConverter x:Key="QuotedTextBrushConverter" />
        <converters:BubbleCornerRadiusConverter x:Key="BubbleCornerRadiusConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <converters:MessageStatusSendingVisibilityConverter x:Key="MessageStatusSendingVisibilityConverter" />
        <converters:MessageStatusSentVisibilityConverter x:Key="MessageStatusSentVisibilityConverter" />
        <converters:MessageStatusDoubleCheckVisibilityConverter x:Key="MessageStatusDoubleCheckVisibilityConverter" />
        <converters:MessageStatusBrushConverter x:Key="MessageStatusBrushConverter" />
        <converters:BoolToPlayPauseGlyphConverter x:Key="BoolToPlayPauseGlyphConverter" />
        <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="AppAccentElevationBorderFocusedBrush" />

    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Canvas.ZIndex="20" Padding="16" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <PersonPicture ProfilePicture="{x:Bind ViewModel.CurrentChat.PictureUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                               IsGroup="{x:Bind ViewModel.CurrentChat.IsGroup, Mode=OneWay}"
                               Initials="{x:Bind ViewModel.CurrentChat.Initials, Mode=OneWay}"
                               DisplayName="{x:Bind ViewModel.CurrentChat, Mode=OneWay, Converter={StaticResource PersonPictureDisplayNameConverter}}"
                               Width="40" Height="40" />
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.HeaderTitle, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.HeaderSubtitle, Mode=OneWay}" 
                               FontSize="12" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind ViewModel.HeaderSubtitle, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Messages -->
        <Grid Grid.Row="1">
            <Canvas x:Name="DoodleCanvas"
                    Visibility="{x:Bind ViewModel.IsDoodleWallpaperVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Opacity="{ThemeResource WhatsAppDoodleOpacity}"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    SizeChanged="DoodleCanvas_SizeChanged" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Width="36" Height="36"
                          AutomationProperties.Name="Loading conversation" />
            <ListView x:Name="MessagesListView" ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}" SelectionMode="None" Padding="16,8,16,16" Loaded="MessagesListView_Loaded" AutomationProperties.Name="Messages list" AutomationProperties.AutomationId="MessagesListView">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.Header>
                        <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingOlder, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsLoadingOlder, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                      HorizontalAlignment="Center"
                                      Width="24" Height="24" Margin="0,8"
                                      AutomationProperties.Name="Loading older messages" />
                    </ListView.Header>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Message">
                            <Grid Margin="0,4" HorizontalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Separators Stack -->
                                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="6" Margin="0,4,0,16"
                                            Visibility="{x:Bind HasAnySeparator, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <!-- Inline Date Separator Pill Button -->
                                    <Border HorizontalAlignment="Center"
                                            Padding="12,4"
                                            CornerRadius="12"
                                            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Visibility="{x:Bind ShowDateSeparator, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind DateSeparatorText, Mode=OneWay}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>

                                    <!-- Unread Messages Separator Badge -->
                                    <Border HorizontalAlignment="Center"
                                            Padding="14,4"
                                            CornerRadius="12"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource AppAccentBrush}"
                                            BorderThickness="1"
                                            Visibility="{x:Bind ShowUnreadSeparator, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind UnreadSeparatorText, Mode=OneWay}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AppAccentBrush}" />
                                    </Border>
                                </StackPanel>

                                <!-- System Alert / Notice (Centered) -->
                                <Border Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,6"
                                        Margin="0,4"
                                        MaxWidth="420"
                                        Visibility="{x:Bind IsSystemNotice, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind Content.Text, Mode=OneTime}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Message Bubble Row Container (Spans full horizontal extent for hover hit-testing) -->
                                <Grid Grid.Row="1"
                                      HorizontalAlignment="Stretch"
                                      Background="Transparent"
                                      Visibility="{x:Bind IsSystemNotice, Mode=OneTime, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                      PointerEntered="MessageBubbleRow_PointerEntered"
                                      PointerExited="MessageBubbleRow_PointerExited">
                                    <Grid HorizontalAlignment="{x:Bind IsOutgoing, Mode=OneTime, Converter={StaticResource OutgoingAlignmentConverter}}"
                                          ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Outgoing Reaction Trigger (Left of outgoing bubble) -->
                                        <Button Grid.Column="0"
                                                x:Name="OutgoingReactionButton"
                                                Width="28" Height="28"
                                                Padding="0"
                                                CornerRadius="14"
                                                VerticalAlignment="Center"
                                                Opacity="0"
                                                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                ToolTipService.ToolTip="React"
                                                Visibility="{x:Bind IsOutgoing, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <FontIcon Glyph="&#xE76E;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Button.Flyout>
                                                <Flyout Placement="Top">
                                                    <Flyout.FlyoutPresenterStyle>
                                                        <Style TargetType="FlyoutPresenter">
                                                            <Setter Property="Padding" Value="0"/>
                                                            <Setter Property="CornerRadius" Value="14"/>
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Setter Property="Shadow" Value="{x:Null}"/>
                                                        </Style>
                                                    </Flyout.FlyoutPresenterStyle>
                                                    <controls:EmojiReactionPicker EmojiSelected="EmojiPicker_EmojiSelected" />
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>

                                    <!-- Main Bubble Column -->
                                    <StackPanel Grid.Column="1" MaxWidth="480" Spacing="2">
                                        <Grid>
                                            <!-- Incoming protruding tail (top-left) -->
                                            <Path Data="M 2.812,0 H 8 V 11.193 L 1.533,3.568 C 0.5,2.25 1.062,0 2.812,0 Z"
                                                  Fill="{x:Bind Converter={StaticResource OutgoingBackgroundConverter}}"
                                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                                  Margin="-7,0,0,0" Width="8" Height="13"
                                                  Visibility="{x:Bind IsOutgoing, Mode=OneTime, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                                            <!-- Outgoing protruding tail (top-right) -->
                                            <Path Data="M 0,0 H 5.188 C 6.938,0 7.5,1.25 6.467,2.568 L 0,11.193 Z"
                                                  Fill="{x:Bind Converter={StaticResource OutgoingBackgroundConverter}}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                                  Margin="0,0,-7,0" Width="8" Height="13"
                                                  Visibility="{x:Bind IsOutgoing, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <!-- Main Bubble Box -->
                                            <Border Padding="12,8" CornerRadius="{x:Bind IsOutgoing, Mode=OneTime, Converter={StaticResource BubbleCornerRadiusConverter}}" 
                                                    Background="{x:Bind Converter={StaticResource OutgoingBackgroundConverter}}">
                                                <StackPanel Spacing="4">
                                                    <!-- Sender Name (for incoming messages in groups) -->
                                                    <TextBlock Text="{x:Bind SenderName, Mode=OneTime}"
                                                               FontWeight="SemiBold"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource AppAccentBrush}"
                                                               Visibility="{x:Bind Converter={StaticResource GroupSenderVisibilityConverter}}"
                                                               TextTrimming="CharacterEllipsis" />

                                                    <!-- Quoted / Reply Preview -->
                                                    <Border Visibility="{x:Bind QuotedText, Mode=OneTime, Converter={StaticResource StringToVisibilityConverter}}"
                                                            Background="{x:Bind IsOutgoing, Mode=OneTime, Converter={StaticResource QuotedBackgroundConverter}}"
                                                            BorderBrush="{x:Bind IsOutgoing, Mode=OneTime, Converter={StaticResource QuotedBorderBrushConverter}}"
                                                            BorderThickness="3,0,0,0"
                                                            CornerRadius="4"
                                                            Padding="8,4"
                                                            Margin="-8,-4,-8,4">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{x:Bind QuotedSender, Mode=OneTime}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="11"
                                                                       Foreground="{x:Bind IsOutgoing, Mode=OneTime, Converter={StaticResource QuotedSenderBrushConverter}}"
                                                                       Visibility="{x:Bind QuotedSender, Mode=OneTime, Converter={StaticResource StringToVisibilityConverter}}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{x:Bind QuotedText, Mode=OneTime}"
                                                                       FontSize="12"
                                                                       Foreground="{x:Bind IsOutgoing, Mode=OneTime, Converter={StaticResource QuotedTextBrushConverter}}"
                                                                       MaxLines="2"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Photo Bubble -->
                                                    <Border Visibility="{x:Bind Content.IsImage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            CornerRadius="6"
                                                            Margin="-8,-4,-8,2"
                                                            MaxWidth="320">
                                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <!-- Image element (when EffectiveImagePath has value) -->
                                                            <Image Source="{x:Bind Content.EffectiveImagePath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                                   Stretch="UniformToFill"
                                                                   MaxHeight="260"
                                                                   HorizontalAlignment="Center"
                                                                   Tapped="MediaBubble_Tapped"
                                                                   Visibility="{x:Bind Content.EffectiveImagePath, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />

                                                            <!-- Placeholder (when EffectiveImagePath is null/empty, e.g. older media not yet downloaded) -->
                                                            <Border Width="240" Height="180"
                                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                                    CornerRadius="6"
                                                                    Tapped="MediaBubble_Tapped"
                                                                    Visibility="{x:Bind Content.EffectiveImagePath, Mode=OneWay, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                                <FontIcon Glyph="&#xEB9F;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>

                                                            <!-- Overlay: Download Button (visible when !IsDownloaded && !IsDownloading) -->
                                                            <Button Click="DownloadMedia_Click"
                                                                    Width="44" Height="44"
                                                                    Padding="0"
                                                                    Background="#99000000"
                                                                    BorderThickness="0"
                                                                    CornerRadius="22"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    ToolTipService.ToolTip="Download photo"
                                                                    Visibility="{x:Bind Content.ShowDownloadIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <FontIcon Glyph="&#xE896;" FontSize="18" Foreground="White" />
                                                            </Button>

                                                            <!-- Overlay: Circular ProgressRing with embedded Cancel Button (visible when IsDownloading) -->
                                                            <Grid Visibility="{x:Bind Content.IsDownloading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Width="44" Height="44">
                                                                <Border Background="#99000000" CornerRadius="22" Width="44" Height="44" />
                                                                <ProgressRing IsIndeterminate="{x:Bind Content.IsProgressIndeterminate, Mode=OneWay}"
                                                                              Value="{x:Bind Content.DownloadProgress, Mode=OneWay}"
                                                                              Maximum="100"
                                                                              Width="40" Height="40"
                                                                              Foreground="White" />
                                                                <Button Click="CancelDownload_Click"
                                                                        Width="28" Height="28"
                                                                        Padding="0"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        CornerRadius="14"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        ToolTipService.ToolTip="Cancel download">
                                                                    <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="White" />
                                                                </Button>
                                                            </Grid>
                                                        </Grid>

                                                        <Border.ContextFlyout>
                                                            <MenuFlyout>
                                                                <MenuFlyoutItem Text="Open" Click="OpenMediaInApp_Click">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE7AC;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem Text="Open with default app" Click="OpenMediaDefaultApp_Click">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE7AC;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem Text="Save as..." Click="SaveMediaAs_Click">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE74E;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                            </MenuFlyout>
                                                        </Border.ContextFlyout>
                                                    </Border>

                                                    <!-- Video Bubble -->
                                                    <Grid Visibility="{x:Bind Content.IsVideo, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                          CornerRadius="6"
                                                          Margin="-8,-4,-8,2"
                                                          MaxWidth="320"
                                                          Background="Transparent"
                                                          Tapped="MediaBubble_Tapped">
                                                        <!-- Image element (thumbnail/poster) -->
                                                        <Image Source="{x:Bind Content.EffectiveImagePath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                               Stretch="UniformToFill"
                                                               MaxHeight="260"
                                                               HorizontalAlignment="Center"
                                                               Visibility="{x:Bind Content.EffectiveImagePath, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />

                                                        <!-- Placeholder (when EffectiveImagePath is null/empty) -->
                                                        <Border Width="240" Height="180"
                                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                                CornerRadius="6"
                                                                Visibility="{x:Bind Content.EffectiveImagePath, Mode=OneWay, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                            <FontIcon Glyph="&#xE714;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>

                                                        <!-- Overlay: Play Button (visible when IsDownloaded) -->
                                                        <Border Background="#60000000"
                                                                CornerRadius="24"
                                                                Width="48" Height="48"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                IsHitTestVisible="False"
                                                                Visibility="{x:Bind Content.IsDownloaded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <FontIcon Glyph="&#xE768;" FontSize="20" Foreground="White" Margin="2,0,0,0" />
                                                        </Border>

                                                        <!-- Overlay: Download Button (visible when !IsDownloaded && !IsDownloading) -->
                                                        <Button Click="DownloadMedia_Click"
                                                                Width="44" Height="44"
                                                                Padding="0"
                                                                Background="#99000000"
                                                                BorderThickness="0"
                                                                CornerRadius="22"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                ToolTipService.ToolTip="Download video"
                                                                Visibility="{x:Bind Content.ShowDownloadIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <FontIcon Glyph="&#xE896;" FontSize="18" Foreground="White" />
                                                        </Button>

                                                        <!-- Overlay: Circular ProgressRing with embedded Cancel Button (visible when IsDownloading) -->
                                                        <Grid Visibility="{x:Bind Content.IsDownloading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Width="44" Height="44">
                                                            <Border Background="#99000000" CornerRadius="22" Width="44" Height="44" />
                                                            <ProgressRing IsIndeterminate="{x:Bind Content.IsProgressIndeterminate, Mode=OneWay}"
                                                                          Value="{x:Bind Content.DownloadProgress, Mode=OneWay}"
                                                                          Maximum="100"
                                                                          Width="40" Height="40"
                                                                          Foreground="White" />
                                                            <Button Click="CancelDownload_Click"
                                                                    Width="28" Height="28"
                                                                    Padding="0"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    CornerRadius="14"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    ToolTipService.ToolTip="Cancel download">
                                                                <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="White" />
                                                            </Button>
                                                        </Grid>

                                                        <!-- Duration Badge -->
                                                        <Border Background="#80000000"
                                                                CornerRadius="4"
                                                                Padding="6,2"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Bottom"
                                                                Margin="8"
                                                                IsHitTestVisible="False"
                                                                Visibility="{x:Bind Content.FormattedDuration, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                                                            <TextBlock Text="{x:Bind Content.FormattedDuration, Mode=OneWay}"
                                                                       FontSize="11"
                                                                       Foreground="White" />
                                                        </Border>

                                                        <Grid.ContextFlyout>
                                                            <MenuFlyout>
                                                                <MenuFlyoutItem Text="Open" Click="OpenMediaInApp_Click">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE7AC;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem Text="Open with default app" Click="OpenMediaDefaultApp_Click">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE7AC;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem Text="Save as..." Click="SaveMediaAs_Click">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE74E;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                            </MenuFlyout>
                                                        </Grid.ContextFlyout>
                                                    </Grid>

                                                    <!-- Document Card -->
                                                    <Border Visibility="{x:Bind Content.IsDocument, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="12,10"
                                                            Margin="-8,-4,-8,4"
                                                            MinWidth="240"
                                                            MaxWidth="320"
                                                            Tapped="DocumentCard_Tapped">
                                                        <StackPanel Spacing="6">
                                                            <Grid ColumnSpacing="12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Document Icon Badge -->
                                                                <Border Grid.Column="0"
                                                                        Width="38" Height="38"
                                                                        CornerRadius="6"
                                                                        Background="{ThemeResource AppAccentBrush}"
                                                                        VerticalAlignment="Center">
                                                                    <FontIcon Glyph="&#xE8A5;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>

                                                                <!-- File Name & Size + File Type -->
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                                    <TextBlock Text="{x:Bind Content.DisplayName, Mode=OneWay}"
                                                                               FontWeight="SemiBold"
                                                                               FontSize="13"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               MaxLines="1" />
                                                                    <TextBlock Text="{x:Bind Content.FormattedSizeAndType, Mode=OneWay}"
                                                                               FontSize="11"
                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                </StackPanel>

                                                                <!-- Action Area: Download Icon OR Progress Ring with Cancel OR Open Ready Icon -->
                                                                <Grid Grid.Column="2" VerticalAlignment="Center" Width="36" Height="36">
                                                                    <!-- Download Icon -->
                                                                    <FontIcon Glyph="&#xE896;"
                                                                              FontSize="16"
                                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              Visibility="{x:Bind Content.ShowDownloadIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                                    <!-- Progress Ring with Cancel Button in center -->
                                                                    <Grid Visibility="{x:Bind Content.IsDownloading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          Width="36" Height="36">
                                                                        <ProgressRing IsIndeterminate="{x:Bind Content.IsProgressIndeterminate, Mode=OneWay}"
                                                                                      Value="{x:Bind Content.DownloadProgress, Mode=OneWay}"
                                                                                      Maximum="100"
                                                                                      Width="34" Height="34" />
                                                                        <Button Click="CancelDownload_Click"
                                                                                Width="24" Height="24"
                                                                                Padding="0"
                                                                                Background="Transparent"
                                                                                BorderThickness="0"
                                                                                CornerRadius="12"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"
                                                                                ToolTipService.ToolTip="Cancel download">
                                                                            <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                        </Button>
                                                                    </Grid>

                                                                    <!-- Open Ready Icon -->
                                                                    <FontIcon Glyph="&#xE8E5;"
                                                                              FontSize="16"
                                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              Visibility="{x:Bind Content.IsDownloaded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                </Grid>
                                                            </Grid>

                                                            <!-- Downloaded Action Buttons: Side-by-side Open & Save as -->
                                                            <Grid Visibility="{x:Bind Content.IsDownloaded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                  ColumnSpacing="8"
                                                                  Margin="0,4,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Button Grid.Column="0"
                                                                        Click="OpenDocumentDefaultApp_Click"
                                                                        HorizontalAlignment="Stretch"
                                                                        Padding="8,5"
                                                                        CornerRadius="4">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                                        <FontIcon Glyph="&#xE7AC;" FontSize="12" />
                                                                        <TextBlock Text="Open" FontSize="12" />
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button Grid.Column="1"
                                                                        Click="SaveMediaAs_Click"
                                                                        HorizontalAlignment="Stretch"
                                                                        Padding="8,5"
                                                                        CornerRadius="4">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                                        <FontIcon Glyph="&#xE792;" FontSize="12" />
                                                                        <TextBlock Text="Save as" FontSize="12" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </Grid>
                                                        </StackPanel>

                                                        <Border.ContextFlyout>
                                                            <MenuFlyout>
                                                                <MenuFlyoutItem Text="Open with default app" Click="OpenDocumentDefaultApp_Click">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE7AC;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem Text="Save as..." Click="SaveMediaAs_Click">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE74E;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                            </MenuFlyout>
                                                        </Border.ContextFlyout>
                                                    </Border>

                                                    <!-- Audio Bubble -->
                                                    <Border Visibility="{x:Bind Content.IsAudio, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="10,8"
                                                            Margin="-8,-4,-8,4"
                                                            MinWidth="290"
                                                            MaxWidth="340">
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Left: Mic / Audio Icon Badge -->
                                                            <Border Grid.Column="0" VerticalAlignment="Center" Width="38" Height="38" CornerRadius="19"
                                                                    Background="{ThemeResource AppAccentBrush}">
                                                                <FontIcon Glyph="&#xE720;" FontSize="18" Foreground="White"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>

                                                            <!-- Center: Waveform / Slider + Duration & File Info -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                                <controls:WaveformProgressBar Height="24"
                                                                                              Value="{x:Bind Content.PlaybackProgress, Mode=OneWay}"
                                                                                              SeekRequested="AudioWaveform_SeekRequested"
                                                                                              IsEnabled="{x:Bind Content.IsDownloaded, Mode=OneWay}"
                                                                                              Margin="0,2,0,2" />
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid Grid.Column="0">
                                                                        <TextBlock Text="{x:Bind Content.PlaybackTimeText, Mode=OneWay}"
                                                                                   FontSize="11"
                                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                   HorizontalAlignment="Left"
                                                                                   Visibility="{x:Bind Content.IsPlaying, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                        <TextBlock Text="{x:Bind Content.FormattedDuration, Mode=OneWay}"
                                                                                   FontSize="11"
                                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                   HorizontalAlignment="Left"
                                                                                   Visibility="{x:Bind Content.IsPlaying, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                                    </Grid>
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{x:Bind Content.FormattedSizeAndType, Mode=OneWay}"
                                                                               FontSize="11"
                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                               HorizontalAlignment="Right"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Margin="8,0,0,0" />
                                                                </Grid>
                                                            </StackPanel>

                                                            <!-- Right: Play / Pause / Download Action Button -->
                                                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                                                <!-- Undownloaded: Download Button -->
                                                                <Button Click="DownloadMedia_Click"
                                                                        Width="36" Height="36"
                                                                        Padding="0"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        CornerRadius="18"
                                                                        ToolTipService.ToolTip="Download audio"
                                                                        Visibility="{x:Bind Content.ShowDownloadIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <FontIcon Glyph="&#xE896;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                                </Button>

                                                                <!-- Downloading: Progress Ring + Cancel -->
                                                                <Grid Visibility="{x:Bind Content.IsDownloading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                      Width="36" Height="36">
                                                                    <ProgressRing IsIndeterminate="{x:Bind Content.IsProgressIndeterminate, Mode=OneWay}"
                                                                                  Value="{x:Bind Content.DownloadProgress, Mode=OneWay}"
                                                                                  Maximum="100"
                                                                                  Width="34" Height="34" />
                                                                    <Button Click="CancelDownload_Click"
                                                                            Width="22" Height="22"
                                                                            Padding="0"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            CornerRadius="11"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            ToolTipService.ToolTip="Cancel download">
                                                                        <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                    </Button>
                                                                </Grid>

                                                                <!-- Downloaded: Play / Pause Button -->
                                                                <Button Click="PlayAudio_Click"
                                                                        Width="36" Height="36"
                                                                        Padding="0"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        CornerRadius="18"
                                                                        ToolTipService.ToolTip="Play / Pause"
                                                                        Visibility="{x:Bind Content.IsDownloaded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <FontIcon Glyph="{x:Bind Content.IsPlaying, Mode=OneWay, Converter={StaticResource BoolToPlayPauseGlyphConverter}}" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                                </Button>
                                                            </Grid>
                                                        </Grid>

                                                        <Border.ContextFlyout>
                                                            <MenuFlyout>
                                                                <MenuFlyoutItem Text="Open with default app" Click="OpenDocumentDefaultApp_Click">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE7AC;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem Text="Save as..." Click="SaveMediaAs_Click">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE74E;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                            </MenuFlyout>
                                                        </Border.ContextFlyout>
                                                    </Border>

                                                    <!-- Message Text / Caption with Clickable Links -->
                                                    <RichTextBlock helpers:LinkifyHelper.Text="{x:Bind Content.DisplayCaptionOrText, Mode=OneWay}"
                                                                   Visibility="{x:Bind Content.HasTextOrCaption, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                   MaxWidth="{x:Bind Content.CaptionMaxWidth, Mode=OneWay}"
                                                                   TextWrapping="Wrap"
                                                                   IsTextSelectionEnabled="True"
                                                                   Foreground="{x:Bind IsOutgoing, Mode=OneTime, Converter={StaticResource OutgoingTextColorConverter}}"
                                                                   Margin="0,2,0,0" />

                                                    <!-- Timestamp and status icons -->
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" Margin="0,2,0,-2">
                                                        <TextBlock Text="{x:Bind FormattedTime, Mode=OneTime}" 
                                                                   FontSize="10" 
                                                                   Foreground="{x:Bind IsOutgoing, Mode=OneTime, Converter={StaticResource OutgoingSubtextColorConverter}}" />

                                                        <!-- Status Icon Container for Outgoing Messages -->
                                                        <Grid Visibility="{x:Bind IsOutgoing, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}"
                                                              VerticalAlignment="Center">
                                                            <!-- Sending: Clock icon -->
                                                            <FontIcon Glyph="&#xE916;" FontSize="9"
                                                                      Foreground="{x:Bind IsOutgoing, Mode=OneTime, Converter={StaticResource OutgoingSubtextColorConverter}}"
                                                                      Visibility="{x:Bind Status, Mode=OneWay, Converter={StaticResource MessageStatusSendingVisibilityConverter}}" />

                                                            <!-- Sent: Single checkmark -->
                                                            <FontIcon Glyph="&#xE73E;" FontSize="9"
                                                                      Foreground="{x:Bind IsOutgoing, Mode=OneTime, Converter={StaticResource OutgoingSubtextColorConverter}}"
                                                                      Visibility="{x:Bind Status, Mode=OneWay, Converter={StaticResource MessageStatusSentVisibilityConverter}}" />

                                                            <!-- Delivered and Read: Double checkmark (blue when read) -->
                                                            <Viewbox Width="14" Height="10"
                                                                     Visibility="{x:Bind Status, Mode=OneWay, Converter={StaticResource MessageStatusDoubleCheckVisibilityConverter}}">
                                                                <Path Data="M15.01 3.316l-.478-.372a.365.365 0 0 0-.51.063L8.666 9.879a.32.32 0 0 1-.484.033l-.358-.325a.319.319 0 0 0-.484.032l-.378.483a.418.418 0 0 0 .036.541l1.32 1.266c.143.14.361.125.484-.033l6.272-8.048a.366.366 0 0 0-.064-.512zm-4.1 0l-.478-.372a.365.365 0 0 0-.51.063L4.566 9.879a.32.32 0 0 1-.484.033L1.891 7.769a.366.366 0 0 0-.515.006l-.423.433a.364.364 0 0 0 .006.514l3.258 3.185c.143.14.361.125.484-.033l6.272-8.048a.365.365 0 0 0-.063-.51z"
                                                                      Fill="{x:Bind Status, Mode=OneWay, Converter={StaticResource MessageStatusBrushConverter}}" />
                                                            </Viewbox>
                                                        </Grid>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Reaction pills -->
                                        <ItemsControl ItemsSource="{x:Bind Reactions, Mode=OneWay}"
                                                      Visibility="{x:Bind Reactions, Mode=OneWay, Converter={StaticResource CollectionToVisibilityConverter}}"
                                                      HorizontalAlignment="{x:Bind IsOutgoing, Mode=OneTime, Converter={StaticResource OutgoingAlignmentConverter}}"
                                                      Margin="4,-4,4,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="4"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Button Click="ReactionPill_Click"
                                                            Tag="{x:Bind}"
                                                            Padding="6,2"
                                                            CornerRadius="10"
                                                            BorderThickness="1"
                                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            MinHeight="22" MinWidth="24">
                                                        <TextBlock Text="{x:Bind}" FontSize="12"/>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Incoming Reaction Trigger (Right of incoming bubble) -->
                                    <Button Grid.Column="2"
                                            x:Name="IncomingReactionButton"
                                            Width="28" Height="28"
                                            Padding="0"
                                            CornerRadius="14"
                                            VerticalAlignment="Center"
                                            Opacity="0"
                                            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            ToolTipService.ToolTip="React"
                                            Visibility="{x:Bind IsOutgoing, Mode=OneTime, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <FontIcon Glyph="&#xE76E;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Button.Flyout>
                                            <Flyout Placement="Top">
                                                <Flyout.FlyoutPresenterStyle>
                                                    <Style TargetType="FlyoutPresenter">
                                                        <Setter Property="Padding" Value="0"/>
                                                        <Setter Property="CornerRadius" Value="14"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Shadow" Value="{x:Null}"/>
                                                    </Style>
                                                </Flyout.FlyoutPresenterStyle>
                                                <controls:EmojiReactionPicker EmojiSelected="EmojiPicker_EmojiSelected" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            <!-- Date Context Pill Button (pops in on scroll, pops out on stop) -->
            <Border x:Name="FloatingDatePill"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,16,0,0"
                    Padding="12,4"
                    CornerRadius="12"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Canvas.ZIndex="10"
                    IsHitTestVisible="False"
                    Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="PillTransform" Y="-50" />
                </Border.RenderTransform>
                <TextBlock Text="{x:Bind ViewModel.CurrentChatDateString, Mode=OneWay}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>
        </Grid>

        <!-- Input Area -->
        <Grid Grid.Row="2" Padding="16" Background="Transparent" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <!-- Composer Action Buttons: Emoji & Attachment -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" Margin="0,0,8,0" VerticalAlignment="Bottom">
                <!-- Emoji Button (Placeholder) -->
                <Button Width="38" Height="36"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="4"
                        ToolTipService.ToolTip="Emoji, GIFs, and Stickers"
                        AutomationProperties.Name="Emoji button">
                    <FontIcon Glyph="&#xE76E;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>

                <!-- Attachment Button with Styled Flyout -->
                <Button Width="38" Height="36"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="4"
                        ToolTipService.ToolTip="Attach"
                        AutomationProperties.Name="Attachment button">
                    <FontIcon Glyph="&#xE723;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="AttachFlyout" Placement="TopEdgeAlignedLeft">
                            <MenuFlyoutItem Text="Document" Click="AttachDocument_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8A5;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Photos &amp; videos" Click="AttachMedia_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xEB9F;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Camera" Click="AttachCamera_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE722;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Audio" Click="AttachAudio_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8D6;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Contact">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE77B;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Poll">
                                <MenuFlyoutItem.Icon>
                                    <PathIcon Data="M2,4.5 C2,3.67 2.67,3 3.5,3 L14.5,3 C15.33,3 16,3.67 16,4.5 C16,5.33 15.33,6 14.5,6 L3.5,6 C2.67,6 2,5.33 2,4.5 Z M2,9.5 C2,8.67 2.67,8 3.5,8 L11.5,8 C12.33,8 13,8.67 13,9.5 C13,10.33 12.33,11 11.5,11 L3.5,11 C2.67,11 2,10.33 2,9.5 Z M2,14.5 C2,13.67 2.67,13 3.5,13 L8.5,13 C9.33,13 10,13.67 10,14.5 C10,15.33 9.33,16 8.5,16 L3.5,16 C2.67,16 2,15.33 2,14.5 Z" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="New sticker">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xF4A5;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            
            <TextBox x:Name="MessageInputBox" Grid.Column="1" Text="{x:Bind ViewModel.MessageText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="MessageInputBox_PreviewKeyDown" x:Uid="TypeMessageInput" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="100" AutomationProperties.Name="Message input box" AutomationProperties.AutomationId="MessageInputBox" />
            <Button Grid.Column="2" Margin="12,0,0,0" Command="{x:Bind ViewModel.SendMessageCommand}" Style="{ThemeResource AppAccentButtonStyle}" VerticalAlignment="Bottom" x:Uid="SendMessageBtn" AutomationProperties.AutomationId="SendBtn">
                <FontIcon Glyph="&#xE122;" />
            </Button>
        </Grid>

        <!-- In-App Media Viewer Lightbox Modal -->
        <Grid x:Name="MediaViewerOverlay"
              Grid.RowSpan="3"
              Canvas.ZIndex="1000"
              Background="#E6000000"
              Visibility="{x:Bind ViewModel.IsMediaViewerOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Grid.Resources>
                <Storyboard x:Name="LightboxEntranceStoryboard">
                    <DoubleAnimation Storyboard.TargetName="MediaViewerOverlay"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.0" To="1.0"
                                     Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LightboxContentScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="0.88" To="1.0"
                                     Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LightboxContentScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="0.88" To="1.0"
                                     Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Toolbar -->
            <Grid Grid.Row="0" Padding="16,12" Background="#40000000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.ActiveMediaTitle, Mode=OneWay}"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Foreground="White"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="400" />
                    <TextBlock Text="{x:Bind ViewModel.ActiveMediaSubtitle, Mode=OneWay}"
                               FontSize="12"
                               Foreground="#B0FFFFFF"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <!-- Save as... -->
                    <Button Command="{x:Bind ViewModel.SaveActiveMediaAsCommand}"
                            ToolTipService.ToolTip="Save as..."
                            Background="Transparent" BorderThickness="0" Padding="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="14" Foreground="White" />
                            <TextBlock Text="Save as..." FontSize="12" Foreground="White" />
                        </StackPanel>
                    </Button>

                    <!-- Open with default app -->
                    <Button Command="{x:Bind ViewModel.OpenActiveMediaInDefaultAppCommand}"
                            ToolTipService.ToolTip="Open with default app"
                            Background="Transparent" BorderThickness="0" Padding="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7AC;" FontSize="14" Foreground="White" />
                            <TextBlock Text="Open with default app" FontSize="12" Foreground="White" />
                        </StackPanel>
                    </Button>

                    <!-- Close button -->
                    <Button Command="{x:Bind ViewModel.CloseMediaViewerCommand}"
                            ToolTipService.ToolTip="Close (Esc)"
                            Background="Transparent" BorderThickness="0" Padding="8">
                        <FontIcon Glyph="&#xE711;" FontSize="16" Foreground="White" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Center Content -->
            <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="24" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="LightboxContentScale" ScaleX="1.0" ScaleY="1.0" />
                </Grid.RenderTransform>
                <!-- Photo Viewer -->
                <Image Source="{x:Bind ViewModel.ActiveMediaImageSource, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{x:Bind ViewModel.IsActiveMediaImage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- Video Player -->
                <MediaPlayerElement x:Name="MediaViewerPlayer"
                                    AreTransportControlsEnabled="True"
                                    AutoPlay="True"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.IsActiveMediaVideo, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- Loading spinner while downloading -->
                <ProgressRing IsActive="{x:Bind ViewModel.IsMediaDownloading, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsMediaDownloading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Width="48" Height="48" />
            </Grid>

            <!-- Bottom Caption Bar -->
            <Border Grid.Row="2"
                    Padding="24,12"
                    Background="#40000000"
                    Visibility="{x:Bind ViewModel.ActiveMediaCaption, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                <TextBlock Text="{x:Bind ViewModel.ActiveMediaCaption, Mode=OneWay}"
                           Foreground="White"
                           FontSize="13"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           MaxWidth="700" />
            </Border>
        </Grid>
    </Grid>
</Page>
