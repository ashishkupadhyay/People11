<Page
    x:Class="People.Views.ComingSoonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lottie="using:CommunityToolkit.WinUI.Lottie"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.Background>
            <LinearGradientBrush x:Name="BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop x:Name="ColorStop1" Offset="0.0" Color="Transparent" />
                <GradientStop x:Name="ColorStop2" Offset="1.0" Color="Transparent" />
            </LinearGradientBrush>
        </Grid.Background>
        
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
            <AnimatedVisualPlayer x:Name="AppLottiePlayer" AutoPlay="True" Width="200" Height="200">
                <lottie:LottieVisualSource x:Name="AppLottieSource" />
            </AnimatedVisualPlayer>
            <TextBlock x:Name="TitleTextBlock" x:Uid="ComingSoonTitle" Style="{ThemeResource TitleLargeTextBlockStyle}" Foreground="White" HorizontalAlignment="Center" />
            <TextBlock x:Name="SubtitleTextBlock" x:Uid="ComingSoonDesc" Style="{ThemeResource BodyTextBlockStyle}" Foreground="White" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>

